<Window
    x:Class="WarOfGenesis.Editor.MemberPickWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WarOfGenesis.Editor"
    Title="구성원 고르기"
    Width="1100"
    Height="720"
    WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <!--  아래: 고르기·비우기·취소  -->
        <StackPanel
            Margin="0,8,0,0"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="PickButton"
                Margin="0,0,6,0"
                Padding="12,3"
                AutomationProperties.AutomationId="MemberPickOk"
                Click="Pick_Click"
                Content="이 인물로"
                IsDefault="True" />
            <Button
                x:Name="ClearButton"
                Margin="0,0,6,0"
                Padding="12,3"
                AutomationProperties.AutomationId="MemberPickClear"
                Click="Clear_Click"
                Content="비우기" />
            <Button
                Padding="12,3"
                AutomationProperties.AutomationId="MemberPickCancel"
                Content="취소"
                IsCancel="True" />
            <TextBlock
                x:Name="HintText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Foreground="Gray"
                Text="목록에서 고르고 「이 인물로」(또는 두 번 누르기). 찾기 칸에 이름·번호를 넣으면 거른다." />
        </StackPanel>
        <local:CharacterStatsView x:Name="Stats" />
    </DockPanel>
</Window>
