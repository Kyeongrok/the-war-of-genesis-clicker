<Window
    x:Class="WarOfGenesis.Editor.TowerDefenseEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="타워 디펜스 편집 — 스테이지 · 타워 (assets/data/towerdefense/*.json)"
    Width="1280"
    Height="820"
    WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <!--  아래: 저장 · 상태 글  -->
        <DockPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
            <Button
                x:Name="SaveButton"
                Margin="0,0,6,0"
                Padding="12,3"
                AutomationProperties.AutomationId="TdEditSave"
                Click="Save_Click"
                Content="저장"
                DockPanel.Dock="Left" />
            <Button
                Padding="12,3"
                AutomationProperties.AutomationId="TdEditDefaults"
                Click="Defaults_Click"
                Content="모두 바탕 값으로"
                DockPanel.Dock="Left" />
            <TextBlock
                x:Name="StatusText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Foreground="#555"
                TextWrapping="Wrap" />
        </DockPanel>

        <TabControl>
            <!--  ── 스테이지 ──  -->
            <TabItem Header="스테이지">
                <DockPanel Margin="4">
                    <!--  왼쪽: 스테이지 목록  -->
                    <DockPanel Width="190" Margin="0,0,8,0" DockPanel.Dock="Left">
                        <WrapPanel Margin="0,0,0,4" DockPanel.Dock="Top">
                            <Button Margin="0,0,4,4" Padding="6,2" Click="StageAdd_Click" Content="새로" />
                            <Button Margin="0,0,4,4" Padding="6,2" Click="StageCopy_Click" Content="복사" />
                            <Button Margin="0,0,4,4" Padding="6,2" Click="StageDelete_Click" Content="지우기" />
                            <Button Margin="0,0,4,4" Padding="6,2" Click="StageUp_Click" Content="▲" />
                            <Button Margin="0,0,4,4" Padding="6,2" Click="StageDown_Click" Content="▼" />
                        </WrapPanel>
                        <ListBox
                            x:Name="StageList"
                            AutomationProperties.AutomationId="TdStageList"
                            DisplayMemberPath="Name"
                            SelectionChanged="StageList_SelectionChanged" />
                    </DockPanel>

                    <!--  오른쪽: 스테이지 내용  -->
                    <Grid x:Name="StagePanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="230" />
                        </Grid.RowDefinitions>

                        <!--  칸들  -->
                        <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Text="이름" />
                            <TextBox x:Name="NameBox" Width="130" Margin="0,0,10,0" TextChanged="NameBox_TextChanged" />
                            <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Text="맵" />
                            <ComboBox
                                x:Name="MapBox"
                                Width="140"
                                Margin="0,0,4,0"
                                AutomationProperties.AutomationId="TdMapBox"
                                IsEditable="True"
                                ToolTip="part1:NNNN = 파트1 Obt, NNNN.obt = 파트2 Obt" />
                            <Button Margin="0,0,10,0" Padding="8,1" Click="MapLoad_Click" Content="불러오기" />
                            <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Text="골드" />
                            <TextBox x:Name="GoldBox" Width="50" Margin="0,0,10,0" />
                            <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Text="생명" />
                            <TextBox x:Name="LivesBox" Width="40" Margin="0,0,10,0" />
                            <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Text="웨이브당 HP +" />
                            <TextBox x:Name="HpBox" Width="45" Margin="0,0,10,0" ToolTip="웨이브 n 의 적 HP = 1 + n × 이 값 배" />
                            <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Text="BGM" />
                            <TextBox x:Name="BgmBox" Width="45" Margin="0,0,10,0" />
                            <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Text="기록 열쇠" />
                            <TextBox x:Name="IdBox" Width="100" ToolTip="최고 기록을 적는 열쇠 — 바꾸면 기록이 새로 시작한다" />
                        </WrapPanel>

                        <!--  맵: 클릭으로 길 찍기  -->
                        <DockPanel Grid.Row="1">
                            <DockPanel Margin="0,0,0,4" DockPanel.Dock="Top">
                                <Button Margin="0,0,4,0" Padding="8,1" Click="PathClear_Click" Content="길 지우기" DockPanel.Dock="Left" />
                                <Button Margin="0,0,4,0" Padding="8,1" Click="PathUndo_Click" Content="마지막 점 빼기" DockPanel.Dock="Left" />
                                <Button Margin="0,0,10,0" Padding="8,1" Click="CamCenter_Click" Content="보는 자리 가운데로" DockPanel.Dock="Left" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="#555"
                                    Text="왼클릭: 경유점 더하기(첫 점 입구 · 끝 점 출구) · 오른클릭: 가까운 점 빼기 · Shift+클릭: 노란 네모(게임 화면)를 그 자리로 · 빗금: 못 걷는 칸" />
                            </DockPanel>
                            <ScrollViewer x:Name="MapScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#202020">
                                <Grid x:Name="MapHost" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Image x:Name="MapImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    <Canvas
                                        x:Name="MapOverlay"
                                        Background="Transparent"
                                        MouseLeftButtonDown="MapOverlay_MouseLeftButtonDown"
                                        MouseRightButtonDown="MapOverlay_MouseRightButtonDown" />
                                </Grid>
                            </ScrollViewer>
                        </DockPanel>

                        <!--  적 · 웨이브  -->
                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <DockPanel Margin="0,0,0,2" DockPanel.Dock="Top">
                                    <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="적 (번호는 웨이브의 「적」 칸이 가리키는 차례)" />
                                    <Button Margin="6,0,0,0" Padding="6,0" Click="EnemyDelete_Click" Content="지우기" DockPanel.Dock="Right" />
                                    <Button Margin="6,0,0,0" Padding="6,0" Click="EnemyAdd_Click" Content="더하기" DockPanel.Dock="Right" />
                                    <Border />
                                </DockPanel>
                                <DataGrid
                                    x:Name="EnemyGrid"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    LoadingRow="EnemyGrid_LoadingRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Chr}" Header="인물 번호" />
                                        <DataGridTextColumn Binding="{Binding Fallback}" Header="대신(파트2)" />
                                        <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="이름" />
                                        <DataGridTextColumn Binding="{Binding Hp}" Header="HP" />
                                        <DataGridTextColumn Binding="{Binding Speed}" Header="빠르기(칸/초)" />
                                        <DataGridTextColumn Binding="{Binding Bounty}" Header="골드" />
                                        <DataGridTextColumn Binding="{Binding Leak}" Header="생명 깎기" />
                                        <DataGridTextColumn Binding="{Binding Armor}" Header="방어" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <DockPanel Margin="0,0,0,2" DockPanel.Dock="Top">
                                    <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="웨이브" />
                                    <Button Margin="6,0,0,0" Padding="6,0" Click="WaveDelete_Click" Content="지우기" DockPanel.Dock="Right" />
                                    <Button Margin="6,0,0,0" Padding="6,0" Click="WaveAdd_Click" Content="더하기" DockPanel.Dock="Right" />
                                    <Border />
                                </DockPanel>
                                <DataGrid
                                    x:Name="WaveGrid"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Wave}" Header="웨이브" />
                                        <DataGridTextColumn Binding="{Binding Enemy}" Header="적 번호" />
                                        <DataGridTextColumn Width="*" Binding="{Binding EnemyName, Mode=OneWay}" Header="적" IsReadOnly="True" />
                                        <DataGridTextColumn Binding="{Binding Count}" Header="수" />
                                        <DataGridTextColumn Binding="{Binding Every}" Header="간격(초)" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!--  ── 타워 ──  -->
            <TabItem Header="타워">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="300" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <DockPanel Margin="0,0,0,2" DockPanel.Dock="Top">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="타워 — 영웅이 아니면 「병종」 탭, 영웅이면 「영웅」 탭(하나씩만 · 오라). 한 탭에 10개까지 보인다. 인물 번호: 파트1 = 20000 + 번호, 파트2 = 그대로" />
                            <Button Margin="6,0,0,0" Padding="6,0" Click="TowerDown_Click" Content="▼" DockPanel.Dock="Right" />
                            <Button Margin="6,0,0,0" Padding="6,0" Click="TowerUp_Click" Content="▲" DockPanel.Dock="Right" />
                            <Button Margin="6,0,0,0" Padding="6,0" Click="TowerDelete_Click" Content="지우기" DockPanel.Dock="Right" />
                            <Button Margin="6,0,0,0" Padding="6,0" Click="TowerAdd_Click" Content="더하기" DockPanel.Dock="Right" />
                            <Border />
                        </DockPanel>
                        <DataGrid
                            x:Name="TowerGrid"
                            AutoGenerateColumns="False"
                            AutomationProperties.AutomationId="TdTowerGrid"
                            CanUserAddRows="False"
                            HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Chr}" Header="인물 번호" />
                                <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="이름" />
                                <DataGridComboBoxColumn x:Name="TowerWeaponColumn" Header="무기 갈래" SelectedValueBinding="{Binding Weapon}" SelectedValuePath="Key" DisplayMemberPath="Value" />
                                <DataGridTextColumn Binding="{Binding Cost}" Header="값(골드)" />
                                <DataGridTextColumn Binding="{Binding Power}" Header="힘(피해 · 사거리 배)" />
                                <DataGridCheckBoxColumn Binding="{Binding Hero}" Header="영웅" />
                                <DataGridComboBoxColumn x:Name="TowerAuraColumn" Header="오라" SelectedValueBinding="{Binding Aura}" SelectedValuePath="Key" DisplayMemberPath="Value" />
                                <DataGridTextColumn Binding="{Binding AuraValue}" Header="오라 값(0.25 = 25%)" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <DockPanel Grid.Row="2">
                        <TextBlock
                            Margin="0,0,0,2"
                            DockPanel.Dock="Top"
                            FontWeight="Bold"
                            Text="무기 갈래 수치 — 사거리 · 범위는 칸, 간격은 초, 탄 빠르기 0 = 근접, 색은 AARRGGBB, 감속 0.45 = 45% 느리게" />
                        <DataGrid
                            x:Name="WeaponGrid"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Key}" Header="갈래" IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding Name}" Header="이름" />
                                <DataGridTextColumn Binding="{Binding Range}" Header="사거리" />
                                <DataGridTextColumn Binding="{Binding Damage}" Header="피해" />
                                <DataGridTextColumn Binding="{Binding Interval}" Header="간격" />
                                <DataGridTextColumn Binding="{Binding Splash}" Header="범위" />
                                <DataGridTextColumn Binding="{Binding Pierce}" Header="꿰뚫기" />
                                <DataGridTextColumn Binding="{Binding Shot}" Header="탄 빠르기" />
                                <DataGridTextColumn Binding="{Binding ShotColor}" Header="색" />
                                <DataGridTextColumn Binding="{Binding Slow}" Header="감속" />
                                <DataGridTextColumn Width="*" Binding="{Binding SlowSeconds}" Header="감속 시간" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
