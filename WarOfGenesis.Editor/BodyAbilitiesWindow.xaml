<Window
    x:Class="WarOfGenesis.Editor.BodyAbilitiesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="개발 — 체질(계열)별 배울 수 있는 어빌리티"
    Width="1100"
    Height="700"
    WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <TextBlock
            Margin="0,6,0,0"
            DockPanel.Dock="Bottom"
            Foreground="DimGray"
            Text="직업마다 배울 수 있는 어빌리티(11칸). 계열(사이클론·타키리온·포스트럴·아크로스트·오즈마) × 형(일반·공격·방어·고속·보조)마다 1·2단계 공통 목록 한 벌을 고치면 두 단계에 같이 들어간다. 2단계에만 있는 것·3단계·몬스터 직업은 제 줄에서. 저장하면 저장소 assets/data/jobs/*.json 에 쓰고 게임(duel-dx)이 그것을 읽는다."
            TextWrapping="Wrap" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  왼쪽: 계열 · 단계 · 직업  -->
            <DockPanel Grid.Column="0">
                <StackPanel
                    Margin="0,0,0,6"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="찾기:" />
                    <TextBox
                        x:Name="JobFilterBox"
                        Width="140"
                        Margin="6,0,0,0"
                        AutomationProperties.AutomationId="BodyJobFilterBox"
                        TextChanged="JobFilterBox_TextChanged" />
                </StackPanel>
                <ListBox
                    x:Name="JobList"
                    AutomationProperties.AutomationId="BodyJobList"
                    DisplayMemberPath="Label"
                    SelectionChanged="JobList_SelectionChanged" />
            </DockPanel>

            <GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch" />

            <!--  오른쪽: 그 직업의 어빌리티 11칸  -->
            <DockPanel Grid.Column="2">
                <TextBlock
                    x:Name="JobTitle"
                    Margin="0,0,0,6"
                    DockPanel.Dock="Top"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="왼쪽에서 계열을 고르세요"
                    TextWrapping="Wrap" />

                <StackPanel
                    Margin="0,0,0,6"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="더할 어빌리티:" />
                    <TextBox
                        x:Name="AbilityFilterBox"
                        Width="140"
                        Margin="6,0,0,0"
                        AutomationProperties.AutomationId="BodyAbilityFilterBox"
                        TextChanged="AbilityFilterBox_TextChanged"
                        ToolTip="이름이나 번호로 거른다" />
                    <ComboBox
                        x:Name="AbilityPicker"
                        Width="260"
                        Margin="6,0,0,0"
                        AutomationProperties.AutomationId="BodyAbilityPicker"
                        DisplayMemberPath="Label" />
                    <Button
                        x:Name="AddButton"
                        Margin="6,0,0,0"
                        Padding="10,2"
                        AutomationProperties.AutomationId="BodyAddButton"
                        Click="AddButton_Click"
                        Content="추가(_A)" />
                    <Button
                        x:Name="RemoveButton"
                        Margin="6,0,0,0"
                        Padding="10,2"
                        AutomationProperties.AutomationId="BodyRemoveButton"
                        Click="RemoveButton_Click"
                        Content="삭제(_D)" />
                    <CheckBox
                        x:Name="Stage2Only"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="BodyStage2Only"
                        Content="2단계에만"
                        ToolTip="켜면 고른 형의 「2단계에만 더함」 쪽에 더한다(다른 체질이 이 계열로 갈아탔을 때만 배움)" />
                </StackPanel>

                <StackPanel
                    Margin="0,6,0,0"
                    DockPanel.Dock="Bottom"
                    Orientation="Horizontal">
                    <Button
                        x:Name="SaveButton"
                        Padding="14,3"
                        AutomationProperties.AutomationId="BodySaveButton"
                        Click="SaveButton_Click"
                        Content="저장(_S)" />
                    <Button
                        x:Name="RevertButton"
                        Margin="6,0,0,0"
                        Padding="14,3"
                        AutomationProperties.AutomationId="BodyRevertButton"
                        Click="RevertButton_Click"
                        Content="되돌리기(_R)" />
                    <TextBlock
                        x:Name="StatusText"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="DimGray" />
                </StackPanel>

                <!--  열 = 형(일반·공격·방어·고속·보조)과 3단계, 행 = 어빌리티 칸. 칸을 고르고 추가·삭제한다.  -->
                <DataGrid
                    x:Name="Table"
                    AutomationProperties.AutomationId="BodyTable"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserReorderColumns="False"
                    CanUserSortColumns="False"
                    GridLinesVisibility="All"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    SelectionUnit="Cell" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
