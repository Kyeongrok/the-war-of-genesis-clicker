<Window
    x:Class="WarOfGenesis.Editor.BodyAbilitiesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="개발 — 체질(계열)별 배울 수 있는 어빌리티"
    Width="1100"
    Height="700"
    WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <TextBlock
            Margin="0,6,0,0"
            DockPanel.Dock="Bottom"
            Foreground="DimGray"
            Text="Dat/Job.dat 레코드의 어빌리티 11칸(파일 31~52). 직업은 Dep.dat 계열(사이클론·타키리온·포스트럴·아크로스트·오즈마) × 단계 × 형(일반·공격·방어·고속·보조)으로 묶었다. 저장하면 저장소 assets/data/Dat/Job.dat 에 쓰고(처음 한 번 .bak 를 남긴다) 게임(duel-dx)이 그 파일을 읽는다."
            TextWrapping="Wrap" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  왼쪽: 계열 · 단계 · 직업  -->
            <DockPanel Grid.Column="0">
                <StackPanel
                    Margin="0,0,0,6"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="직업 찾기:" />
                    <TextBox
                        x:Name="JobFilterBox"
                        Width="200"
                        Margin="6,0,0,0"
                        AutomationProperties.AutomationId="BodyJobFilterBox"
                        TextChanged="JobFilterBox_TextChanged" />
                </StackPanel>
                <ListBox
                    x:Name="JobList"
                    AutomationProperties.AutomationId="BodyJobList"
                    DisplayMemberPath="Label"
                    SelectionChanged="JobList_SelectionChanged" />
            </DockPanel>

            <GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch" />

            <!--  오른쪽: 그 직업의 어빌리티 11칸  -->
            <DockPanel Grid.Column="2">
                <TextBlock
                    x:Name="JobTitle"
                    Margin="0,0,0,6"
                    DockPanel.Dock="Top"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="왼쪽에서 직업을 고르세요" />

                <StackPanel
                    Margin="0,0,0,6"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="더할 어빌리티:" />
                    <TextBox
                        x:Name="AbilityFilterBox"
                        Width="140"
                        Margin="6,0,0,0"
                        AutomationProperties.AutomationId="BodyAbilityFilterBox"
                        TextChanged="AbilityFilterBox_TextChanged"
                        ToolTip="이름이나 번호로 거른다" />
                    <ComboBox
                        x:Name="AbilityPicker"
                        Width="260"
                        Margin="6,0,0,0"
                        AutomationProperties.AutomationId="BodyAbilityPicker"
                        DisplayMemberPath="Label" />
                    <Button
                        x:Name="AddButton"
                        Margin="6,0,0,0"
                        Padding="10,2"
                        AutomationProperties.AutomationId="BodyAddButton"
                        Click="AddButton_Click"
                        Content="추가(_A)" />
                    <Button
                        x:Name="RemoveButton"
                        Margin="6,0,0,0"
                        Padding="10,2"
                        AutomationProperties.AutomationId="BodyRemoveButton"
                        Click="RemoveButton_Click"
                        Content="삭제(_D)" />
                </StackPanel>

                <StackPanel
                    Margin="0,6,0,0"
                    DockPanel.Dock="Bottom"
                    Orientation="Horizontal">
                    <Button
                        x:Name="SaveButton"
                        Padding="14,3"
                        AutomationProperties.AutomationId="BodySaveButton"
                        Click="SaveButton_Click"
                        Content="저장(_S)" />
                    <Button
                        x:Name="RevertButton"
                        Margin="6,0,0,0"
                        Padding="14,3"
                        AutomationProperties.AutomationId="BodyRevertButton"
                        Click="RevertButton_Click"
                        Content="되돌리기(_R)" />
                    <TextBlock
                        x:Name="StatusText"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="DimGray" />
                </StackPanel>

                <ListBox
                    x:Name="SlotList"
                    AutomationProperties.AutomationId="BodySlotList"
                    DisplayMemberPath="Label" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
