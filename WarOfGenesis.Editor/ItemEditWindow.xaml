<Window
    x:Class="WarOfGenesis.Editor.ItemEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="아이템 편집 — Itm.dat (고친 것은 assets/data/items/*.json)"
    Width="1240"
    Height="720"
    WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <!--  위: 종류 고르기 · 이름 찾기  -->
        <StackPanel Margin="0,0,0,6" DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="종류 " />
            <ComboBox
                x:Name="TypeBox"
                Width="200"
                AutomationProperties.AutomationId="ItemEditType"
                SelectionChanged="Filter_Changed" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="이름 " />
            <TextBox
                x:Name="SearchBox"
                Width="160"
                AutomationProperties.AutomationId="ItemEditSearch"
                TextChanged="Filter_Changed" />
            <TextBlock
                x:Name="LegendText"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Foreground="#2B4C7E" />
        </StackPanel>
        <!--  아래: 저장·되돌리기·상태 글  -->
        <DockPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
            <Button
                x:Name="SaveButton"
                Margin="0,0,6,0"
                Padding="12,3"
                AutomationProperties.AutomationId="ItemEditSave"
                Click="Save_Click"
                Content="저장"
                DockPanel.Dock="Left" />
            <Button
                x:Name="RevertButton"
                Padding="12,3"
                AutomationProperties.AutomationId="ItemEditRevert"
                Click="Revert_Click"
                Content="고른 아이템 원본으로"
                DockPanel.Dock="Left" />
            <TextBlock
                x:Name="StatusText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ItemEditStatus"
                TextWrapping="Wrap" />
        </DockPanel>
        <TextBlock
            x:Name="DescriptionText"
            Margin="0,6,0,0"
            DockPanel.Dock="Bottom"
            Foreground="Gray"
            TextWrapping="Wrap" />
        <DataGrid
            x:Name="ItemGrid"
            AutoGenerateColumns="False"
            AutomationProperties.AutomationId="ItemEditList"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CellEditEnding="ItemGrid_CellEditEnding"
            HeadersVisibility="Column"
            SelectionChanged="ItemGrid_SelectionChanged"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Mark, Mode=OneWay}" Header="" IsReadOnly="True" />
                <DataGridTextColumn Binding="{Binding Id, Mode=OneWay}" Header="번호" IsReadOnly="True" />
                <DataGridTextColumn Binding="{Binding Name, Mode=OneWay}" Header="이름" IsReadOnly="True" Width="150" />
                <DataGridTextColumn Binding="{Binding TypeName, Mode=OneWay}" Header="종류" IsReadOnly="True" />
                <DataGridTextColumn Binding="{Binding Price}" Header="값" />
                <DataGridTextColumn Binding="{Binding Attack}" Header="공격" />
                <DataGridTextColumn Binding="{Binding Defense}" Header="방어" />
                <DataGridTextColumn Binding="{Binding Range}" Header="사거리" />
                <DataGridTextColumn Binding="{Binding Stat1}" Header="보정1 번호" />
                <DataGridTextColumn Binding="{Binding Value1}" Header="값" />
                <DataGridTextColumn Binding="{Binding Stat2}" Header="보정2 번호" />
                <DataGridTextColumn Binding="{Binding Value2}" Header="값" />
                <DataGridTextColumn Binding="{Binding Stat3}" Header="보정3 번호" />
                <DataGridTextColumn Binding="{Binding Value3}" Header="값" />
                <DataGridTextColumn Binding="{Binding UseWork}" Header="쓰는 work" />
                <DataGridTextColumn Binding="{Binding Summary, Mode=OneWay}" Header="지금 효과" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
