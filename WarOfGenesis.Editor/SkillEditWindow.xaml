<Window
    x:Class="WarOfGenesis.Editor.SkillEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="스킬 편집 (공통 · 레벨별)"
    Width="1500"
    Height="900"
    WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <StackPanel
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="찾기(이름·번호):" />
            <TextBox
                x:Name="FilterBox"
                Width="200"
                Margin="6,0,0,0"
                AutomationProperties.AutomationId="SkillEditFilter"
                TextChanged="Filter_Changed" />
            <Button
                Margin="12,0,0,0"
                Padding="10,2"
                AutomationProperties.AutomationId="SkillEditSave"
                Click="Save_Click"
                Content="저장(_S)" />
            <Button
                Margin="6,0,0,0"
                Padding="10,2"
                Click="Revert_Click"
                Content="이 스킬 되돌리기" />
            <TextBlock
                x:Name="StatusText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Foreground="DimGray" />
        </StackPanel>
        <TextBlock
            Margin="0,6,0,0"
            DockPanel.Dock="Bottom"
            Foreground="DimGray"
            Text="스킬 하나 = 모든 레벨이 같은 「공통」 칸 한 벌 + 레벨마다 다른 칸(assets/data/skills/NNNN.json, WarOfGenesis.Assets/SkillBook.cs). 공통 칸을 고치면 모든 레벨에 들어간다. 레벨마다 달라야 하는 칸은 공통 표에서 골라 「레벨마다 다르게」로 내리고, 레벨별 표의 열을 골라 「공통으로」 올리면 첫 레벨 값이 모든 레벨의 값이 된다. work 번호는 기술 연출·AI·스크립트가 가리키므로 여기서 안 바꾼다. 저장하면 게임(duel-dx)을 다시 켤 때 반영된다 — 원본 .att 는 그대로 두고 이 파일들만 읽는다."
            TextWrapping="Wrap" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DataGrid
                x:Name="SkillGrid"
                Grid.Column="0"
                AutoGenerateColumns="False"
                AutomationProperties.AutomationId="SkillEditList"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                IsReadOnly="True"
                SelectionChanged="SkillGrid_SelectionChanged"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Ability}" Header="어빌" />
                    <DataGridTextColumn Binding="{Binding Name}" Header="이름" />
                    <DataGridTextColumn Binding="{Binding Levels}" Header="레벨" />
                    <DataGridTextColumn Binding="{Binding Varying}" Header="레벨별 칸" />
                    <DataGridTextColumn Binding="{Binding Dirty}" Header="고침" />
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Stretch" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <Button
                        Padding="8,2"
                        AutomationProperties.AutomationId="SkillEditToLevels"
                        Click="ToLevels_Click"
                        Content="고른 칸을 레벨마다 다르게 ↓"
                        DockPanel.Dock="Right" />
                    <TextBlock
                        x:Name="CommonHeader"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="공통 — 모든 레벨이 같은 칸" />
                </DockPanel>
                <DataGrid
                    x:Name="CommonGrid"
                    Grid.Row="1"
                    AutoGenerateColumns="False"
                    AutomationProperties.AutomationId="SkillEditCommon"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CellEditEnding="CommonGrid_CellEditEnding"
                    HeadersVisibility="Column"
                    SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Binding="{Binding Field}"
                            Header="칸"
                            IsReadOnly="True" />
                        <!--  값 — 정해진 값이 있는 칸(대상 방식·모양·종류)은 드롭다운, 나머지는 수  -->
                        <DataGridTemplateColumn Width="190" Header="값">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <ComboBox
                                            DisplayMemberPath="Label"
                                            ItemsSource="{Binding Choices}"
                                            SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Value"
                                            Visibility="{Binding ChoicesVisibility}" />
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding NumberVisibility}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Binding="{Binding Meaning}"
                            Header="뜻"
                            IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
                <GridSplitter
                    Grid.Row="2"
                    Height="6"
                    HorizontalAlignment="Stretch" />
                <DockPanel Grid.Row="3" Margin="0,4">
                    <Button
                        Padding="8,2"
                        AutomationProperties.AutomationId="SkillEditToCommon"
                        Click="ToCommon_Click"
                        Content="고른 열을 공통으로 ↑ (첫 레벨 값)"
                        DockPanel.Dock="Right" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="레벨별 — 레벨마다 다른 칸만 (열 머리를 눌러 고른 뒤 올린다)" />
                </DockPanel>
                <DataGrid
                    x:Name="LevelGrid"
                    Grid.Row="4"
                    AutoGenerateColumns="True"
                    AutoGeneratingColumn="LevelGrid_AutoGeneratingColumn"
                    AutomationProperties.AutomationId="SkillEditLevels"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserSortColumns="False"
                    CellEditEnding="LevelGrid_CellEditEnding"
                    HeadersVisibility="Column"
                    SelectionUnit="Cell" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
