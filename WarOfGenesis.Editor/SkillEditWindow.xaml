<Window
    x:Class="WarOfGenesis.Editor.SkillEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WarOfGenesis.Editor.Controls"
    Title="스킬 편집 (공통 · 레벨별)"
    Width="1500"
    Height="900"
    WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <StackPanel
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="찾기(이름·번호):" />
            <!--  찾기 칸 — 끝의 ✕ 로 지운다. 넣은 글은 창을 닫아도 남아 다음에 열 때 다시 들어간다(사용자 요청)  -->
            <Grid Width="200" Margin="6,0,0,0">
                <TextBox
                    x:Name="FilterBox"
                    Padding="0,0,20,0"
                    AutomationProperties.AutomationId="SkillEditFilter"
                    TextChanged="Filter_Changed" />
                <Button
                    x:Name="FilterClear"
                    Width="18"
                    Margin="0,1,2,1"
                    Padding="0"
                    HorizontalAlignment="Right"
                    AutomationProperties.AutomationId="SkillEditFilterClear"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="FilterClear_Click"
                    Content="✕"
                    Cursor="Arrow"
                    Focusable="False"
                    Foreground="Gray"
                    ToolTip="찾기 글 지우기"
                    Visibility="Collapsed" />
            </Grid>
            <Button
                Margin="12,0,0,0"
                Padding="10,2"
                Click="Revert_Click"
                Content="이 스킬 되돌리기" />
            <Button
                Margin="6,0,0,0"
                Padding="10,2"
                AutomationProperties.AutomationId="SkillEditSave"
                Click="Save_Click"
                Content="저장(_S)" />
            <TextBlock
                x:Name="StatusText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Foreground="DimGray" />
        </StackPanel>
        <TextBlock
            Margin="0,6,0,0"
            DockPanel.Dock="Bottom"
            Foreground="DimGray"
            Text="스킬 하나 = 모든 레벨이 같은 「공통」 칸 한 벌 + 레벨마다 다른 칸(assets/data/skills/NNNN.json, WarOfGenesis.Assets/SkillBook.cs). 공통 칸을 고치면 모든 레벨에 들어간다. 레벨마다 달라야 하는 칸은 공통 표에서 골라 「레벨마다 다르게」로 내리고, 레벨별 표의 열을 골라 「공통으로」 올리면 첫 레벨 값이 모든 레벨의 값이 된다. work 번호는 기술 연출·AI·스크립트가 가리키므로 여기서 안 바꾼다. 저장하면 게임(duel-dx)을 다시 켤 때 반영된다 — 원본 .att 는 그대로 두고 이 파일들만 읽는다."
            TextWrapping="Wrap" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DataGrid
                x:Name="SkillGrid"
                Grid.Column="0"
                AutoGenerateColumns="False"
                AutomationProperties.AutomationId="SkillEditList"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                IsReadOnly="True"
                SelectionChanged="SkillGrid_SelectionChanged"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Ability}" Header="어빌" />
                    <DataGridTextColumn Binding="{Binding Name}" Header="이름" />
                    <DataGridTextColumn Binding="{Binding Works}" Header="work" />
                    <DataGridTextColumn Binding="{Binding Levels}" Header="레벨" />
                    <DataGridTextColumn Binding="{Binding Varying}" Header="레벨별 칸" />
                    <DataGridTextColumn Binding="{Binding Dirty}" Header="고침" />
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Stretch" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <!--  어빌리티 설명(abi +0x1c TXR)과 선행 조건 — 게임 안 설명 창과 같은 글  -->
                    <TextBlock
                        x:Name="SkillDescription"
                        Margin="0,0,0,8"
                        AutomationProperties.AutomationId="SkillEditDescription"
                        DockPanel.Dock="Top"
                        Foreground="#2B4C7E"
                        TextWrapping="Wrap" />
                    <Button
                        Padding="8,2"
                        AutomationProperties.AutomationId="SkillEditToLevels"
                        Click="ToLevels_Click"
                        Content="고른 칸을 레벨마다 다르게 ↓"
                        DockPanel.Dock="Right" />
                    <TextBlock
                        x:Name="CommonHeader"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="공통 — 모든 레벨이 같은 칸" />
                </DockPanel>
                <!--  공통 칸이 45개라 한 표로는 보기 힘들다 — 사거리·대상·효과 범위 칸과 나머지로 나눠 보인다(사용자 요청)  -->
                <TabControl
                    x:Name="CommonTabs"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="SkillEditCommonTabs"
                    SelectionChanged="CommonTabs_SelectionChanged">
                    <TabItem x:Name="RangeTab" Header="범위" />
                    <TabItem x:Name="OtherTab" Header="나머지" />
                </TabControl>
                <DataGrid
                    x:Name="CommonGrid"
                    Grid.Row="1"
                    Margin="2,26,2,2"
                    AutoGenerateColumns="False"
                    AutomationProperties.AutomationId="SkillEditCommon"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CellEditEnding="CommonGrid_CellEditEnding"
                    HeadersVisibility="Column"
                    SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Binding="{Binding Field}"
                            Header="칸"
                            IsReadOnly="True" />
                        <!--  값 — 정해진 값이 있는 칸(대상 방식·모양·종류)은 드롭다운, 나머지는 수  -->
                        <DataGridTemplateColumn Width="190" Header="값">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding Display}" Visibility="{Binding TextVisibility}" />
                                        <controls:NumericSpinner
                                            Maximum="{Binding SpinnerMax}"
                                            Minimum="{Binding SpinnerMin}"
                                            Step="{Binding SpinnerStep}"
                                            Value="{Binding Value, Mode=OneWay}"
                                            ValueChanged="CommonSpinner_ValueChanged"
                                            Visibility="{Binding SpinnerVisibility}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <ComboBox
                                            DisplayMemberPath="Label"
                                            ItemsSource="{Binding Choices}"
                                            SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Value"
                                            Visibility="{Binding ChoicesVisibility}" />
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding NumberVisibility}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Binding="{Binding Meaning}"
                            Header="뜻"
                            IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
                <GridSplitter
                    Grid.Row="2"
                    Height="6"
                    HorizontalAlignment="Stretch" />
                <!--  제목 줄과 표를 한 칸에 묶는다 — 따로 두면 가름대가 표 대신 제목 줄(Auto)만 늘였다 줄였다 했다(사용자 보고)  -->
                <DockPanel Grid.Row="3">
                <DockPanel Margin="0,4" DockPanel.Dock="Top">
                    <Button
                        Padding="8,2"
                        AutomationProperties.AutomationId="SkillEditToCommon"
                        Click="ToCommon_Click"
                        Content="고른 열을 공통으로 ↑ (첫 레벨 값)"
                        DockPanel.Dock="Right" />
                    <Button
                        Margin="0,0,6,0"
                        Padding="8,2"
                        AutomationProperties.AutomationId="SkillEditDeleteLevel"
                        Click="DeleteLevel_Click"
                        Content="고른 레벨 지우기"
                        DockPanel.Dock="Right"
                        ToolTip="고른 셀의 레벨 줄을 지우고 뒤 레벨을 하나씩 당긴다 — 최대 레벨도 하나 준다(저장할 때 .abi 에도 적는다)" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="레벨별 — 레벨마다 다른 칸만 (열 머리를 눌러 고른 뒤 올린다)" />
                </DockPanel>
                <!--  고른 레벨 work 을 쓰는 곳 — 전투 이벤트 필살기(행동 207)·기본공격 인물. work 번호로 가리키므로 레벨을 지우거나 옮길 때 본다  -->
                <TextBlock
                    x:Name="WorkRefs"
                    Margin="0,4,0,0"
                    AutomationProperties.AutomationId="SkillEditWorkRefs"
                    DockPanel.Dock="Bottom"
                    Foreground="#2B4C7E"
                    TextWrapping="Wrap" />
                <DataGrid
                    x:Name="LevelGrid"
                    CurrentCellChanged="LevelGrid_CurrentCellChanged"
                    AutoGenerateColumns="True"
                    AutoGeneratingColumn="LevelGrid_AutoGeneratingColumn"
                    AutomationProperties.AutomationId="SkillEditLevels"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserSortColumns="False"
                    CellEditEnding="LevelGrid_CellEditEnding"
                    HeadersVisibility="Column"
                    SelectionUnit="Cell" />
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
