<Window
    x:Class="WarOfGenesis.Editor.CustomSpriteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="사용자 그림 만들기 — 그림 시트 → 전투 그림(Obs)"
    Width="1300"
    Height="860"
    WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <StackPanel Margin="0,0,0,6" DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="넣어 둔 그림" />
            <ComboBox x:Name="InstalledBox" Width="150" Margin="4,0,12,0" SelectionChanged="InstalledBox_SelectionChanged" ToolTip="%APPDATA%\DuelDx\sprites 의 사용자 그림 — 고르면 그 설정을 열고 미리보기를 만든다" />
            <TextBlock VerticalAlignment="Center" Text="번호" />
            <TextBox x:Name="IdBox" Width="70" Margin="4,0,12,0" Text="30000" ToolTip="30000~30999" />
            <TextBlock VerticalAlignment="Center" Text="이름" />
            <TextBox x:Name="NameBox" Width="140" Margin="4,0,12,0" Text="에바" />
            <TextBlock VerticalAlignment="Center" Text="게임 안 키(px)" />
            <TextBox x:Name="HeightBox" Width="50" Margin="4,0,12,0" Text="100" ToolTip="인물은 대개 65~95" />
            <Button Margin="0,0,6,0" Padding="10,2" Click="AddSheet_Click" Content="시트 추가…" />
            <Button Margin="0,0,6,0" Padding="10,2" Click="RemoveSheet_Click" Content="고른 줄 빼기" />
            <Button Margin="0,0,6,0" Padding="10,2" Click="OpenProject_Click" Content="설정 열기…" />
            <Button Margin="0,0,18,0" Padding="10,2" Click="SaveProject_Click" Content="설정 저장…" />
            <Button Margin="0,0,6,0" Padding="10,2" Click="Build_Click" Content="만들고 미리보기" FontWeight="Bold" />
            <Button Margin="0,0,6,0" Padding="10,2" Click="Install_Click" Content="게임에 넣기" FontWeight="Bold" />
            <Button Padding="10,2" Click="ViewMotions_Click" Content="모션 보기" />
        </StackPanel>
        <TextBlock
            Margin="0,0,0,6"
            DockPanel.Dock="Top"
            Foreground="#555"
            TextWrapping="Wrap"
            Text="시트 한 장 = 한 줄. 줄은 「방향:위 y:아래 y」를 쉼표로(방향 back 뒷모습 · side 왼쪽을 보는 옆모습 · front 앞모습 — 오른쪽은 게임이 옆모습을 뒤집는다). 시트를 추가하면 줄 · 칸을 그림에서 찾아 채운다(AI 시트는 순서가 틀릴 수 있으니 미리보기로 확인). 배경은 key=rrggbb(단색) 또는 flood=n(칠해진 바탕). 기준은 body(서기 · 걷기) · foot(공격처럼 팔이 뻗는 동작). 맞는 장은 3+6 처럼, 소리는 20022@4+20026@5 처럼(파트1 소리 = 20000 + 번호). 만들기는 편집기 안(C#)에서 한다 — 파이썬이 필요 없다." />
        <TextBox
            x:Name="LogBox"
            Height="90"
            Margin="0,6,0,0"
            DockPanel.Dock="Bottom"
            FontFamily="Consolas"
            IsReadOnly="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <DataGrid
                x:Name="PartsGrid"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="160" Binding="{Binding FileName, Mode=OneWay}" Header="시트" IsReadOnly="True" />
                    <DataGridComboBoxColumn x:Name="ActionColumn" Width="120" Header="동작" SelectedValueBinding="{Binding Action}" SelectedValuePath="Key" DisplayMemberPath="Value" />
                    <DataGridTextColumn Width="220" Binding="{Binding Rows}" Header="줄 (방향:위:아래)" />
                    <DataGridTextColumn Width="55" Binding="{Binding ColX}" Header="첫칸 x" />
                    <DataGridTextColumn Width="55" Binding="{Binding ColW}" Header="칸 너비" />
                    <DataGridTextColumn Width="45" Binding="{Binding Cols}" Header="칸 수" />
                    <DataGridTextColumn Width="90" Binding="{Binding Background}" Header="배경" />
                    <DataGridTextColumn Width="45" Binding="{Binding Anchor}" Header="기준" />
                    <DataGridTextColumn Width="55" Binding="{Binding Hit}" Header="맞는 장" />
                    <DataGridTextColumn Width="140" Binding="{Binding Sound}" Header="소리" />
                    <DataGridTextColumn Width="40" Binding="{Binding Ticks}" Header="틱" />
                </DataGrid.Columns>
            </DataGrid>
            <ScrollViewer Grid.Column="1" Margin="6,0,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#202020">
                <Image x:Name="PreviewImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor">
                    <Image.LayoutTransform>
                        <ScaleTransform ScaleX="2" ScaleY="2" />
                    </Image.LayoutTransform>
                </Image>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
