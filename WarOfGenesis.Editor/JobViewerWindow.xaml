<Window
    x:Class="WarOfGenesis.Editor.JobViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="직업"
    Width="1000"
    Height="720"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <DataTemplate x:Key="PairTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="DimGray" Text="{Binding Label}" />
                <TextBlock
                    Grid.Column="1"
                    FontWeight="SemiBold"
                    Text="{Binding Value}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,14,0,4" />
            <Setter Property="Foreground" Value="#2B4C7E" />
        </Style>
        <DataTemplate x:Key="LineTemplate">
            <TextBlock Margin="0,1" Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  왼쪽 — 찾기와 직업 목록(계열 → 단계 → 형 차례)  -->
        <DockPanel>
            <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
                <TextBlock
                    x:Name="StatusText"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Foreground="DimGray" />
                <TextBox
                    x:Name="FilterBox"
                    AutomationProperties.AutomationId="JobFilterBox"
                    TextChanged="FilterBox_TextChanged"
                    ToolTip="계열·이름·어빌리티·번호로 찾기" />
            </DockPanel>
            <ListBox
                x:Name="List"
                AutomationProperties.AutomationId="JobList"
                HorizontalContentAlignment="Stretch"
                SelectionChanged="List_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <TextBlock
                                Width="30"
                                Foreground="DimGray"
                                Text="{Binding Id}" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Foreground="DimGray"
                                Text="{Binding NeedLevelText}" />
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="Gray"
                                    Text="{Binding Names}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter
            Grid.Column="1"
            Width="8"
            HorizontalAlignment="Stretch" />

        <!--  오른쪽 — 고른 직업의 상세  -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Detail" Margin="8,0,8,8">
                <TextBlock FontSize="22" FontWeight="Bold">
                    <Run Text="{Binding Title, Mode=OneWay}" />
                    <Run
                        FontSize="13"
                        Foreground="DimGray"
                        Text="{Binding Id, StringFormat=직업 {0}, Mode=OneWay}" />
                </TextBlock>
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="DimGray"
                    Text="{Binding Description}"
                    TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource Section}" Text="기본" />
                <ItemsControl ItemTemplate="{StaticResource PairTemplate}" ItemsSource="{Binding Facts}" MaxWidth="560" HorizontalAlignment="Left" />

                <TextBlock Style="{StaticResource Section}" Text="체질별 이름 (빈 칸 = 그 체질은 못 감)" />
                <ItemsControl ItemTemplate="{StaticResource PairTemplate}" ItemsSource="{Binding NamesByBody}" MaxWidth="560" HorizontalAlignment="Left" />

                <TextBlock Style="{StaticResource Section}" Text="레벨당 성장률 %" />
                <ItemsControl ItemTemplate="{StaticResource PairTemplate}" ItemsSource="{Binding Growth}" Width="240" HorizontalAlignment="Left" />

                <TextBlock Style="{StaticResource Section}" Text="배울 수 있는 어빌리티 (Job.dat 11칸)" />
                <ItemsControl ItemTemplate="{StaticResource LineTemplate}" ItemsSource="{Binding Abilities}" />

                <TextBlock Style="{StaticResource Section}" Text="이 직업으로 시작하는 인물 (.chr)" />
                <ItemsControl ItemTemplate="{StaticResource LineTemplate}" ItemsSource="{Binding Characters}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
