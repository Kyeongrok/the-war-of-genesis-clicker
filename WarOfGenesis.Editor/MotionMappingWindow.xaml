<Window
    x:Class="WarOfGenesis.Editor.MotionMappingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="모션 매핑"
    Width="1000"
    Height="700"
    WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <TextBlock
            x:Name="HeaderText"
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            FontWeight="Bold" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <StackPanel
                    Margin="0,0,0,6"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="방향:" />
                    <ComboBox
                        x:Name="DirectionFilter"
                        Width="110"
                        Margin="6,0,0,0"
                        SelectionChanged="Filter_Changed" />
                    <CheckBox
                        x:Name="EmptyToggle"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Checked="Filter_Changed"
                        Content="그림 없는 모션도"
                        Unchecked="Filter_Changed" />
                </StackPanel>
                <ListBox
                    x:Name="MotionList"
                    AutomationProperties.AutomationId="MotionMappingList"
                    SelectionChanged="MotionList_SelectionChanged" />
            </DockPanel>

            <DockPanel Grid.Column="1">
                <StackPanel
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    DockPanel.Dock="Bottom"
                    Orientation="Horizontal">
                    <ToggleButton
                        x:Name="PlayToggle"
                        Width="80"
                        Checked="PlayToggle_Changed"
                        Content="▶ 재생"
                        IsChecked="True"
                        Unchecked="PlayToggle_Changed" />
                    <CheckBox
                        x:Name="MirrorToggle"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Checked="MirrorToggle_Changed"
                        Content="좌우 뒤집기(오른쪽 보기)"
                        Unchecked="MirrorToggle_Changed" />
                    <TextBlock
                        Margin="16,0,6,0"
                        VerticalAlignment="Center"
                        Text="틱/초:" />
                    <Slider
                        x:Name="SpeedSlider"
                        Width="140"
                        VerticalAlignment="Center"
                        IsSnapToTickEnabled="True"
                        Maximum="60"
                        Minimum="5"
                        TickFrequency="5"
                        Value="30" />
                    <TextBlock
                        Width="30"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding ElementName=SpeedSlider, Path=Value}" />
                </StackPanel>

                <TextBlock
                    x:Name="TickInfo"
                    Margin="0,4,0,0"
                    DockPanel.Dock="Bottom"
                    Foreground="DimGray" />

                <TextBox
                    x:Name="KeyList"
                    Height="170"
                    Margin="0,6,0,0"
                    DockPanel.Dock="Bottom"
                    FontFamily="Consolas"
                    IsReadOnly="True"
                    VerticalScrollBarVisibility="Auto" />

                <Border
                    Background="#FF303030"
                    BorderBrush="Gray"
                    BorderThickness="1">
                    <Image
                        x:Name="FrameImage"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                        Stretch="None">
                        <Image.LayoutTransform>
                            <ScaleTransform x:Name="ImageScale" ScaleX="2" ScaleY="2" />
                        </Image.LayoutTransform>
                    </Image>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
