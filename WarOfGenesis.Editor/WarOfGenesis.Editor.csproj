<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <AssemblyName>WarOfGenesis.Editor</AssemblyName>
        <RootNamespace>WarOfGenesis.Editor</RootNamespace>
        <!-- 창·실행 파일 아이콘 — 원본 게임 아이콘(G3_II.ico), 편집기는 아래에 Editor 글자를 얹었다(menu-5) -->
    <ApplicationIcon>..\assets\icons\editor.ico</ApplicationIcon>
  </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\WarOfGenesis.Assets\WarOfGenesis.Assets.csproj" />
    </ItemGroup>

    <!-- 배포용 exe 에 저장소의 assets 폴더(캐릭터·배경)를 함께 싣는다. 단일 exe 로 publish 할 때
         IncludeAllContentForSelfExtract 로 exe 안에 묶여 실행 시 풀린다(AssetsFolder 가 찾는다). -->
    <ItemGroup>
        <Content Include="..\assets\**\*" LinkBase="assets" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
