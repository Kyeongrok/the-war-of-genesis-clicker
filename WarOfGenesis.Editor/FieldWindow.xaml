<Window
    x:Class="WarOfGenesis.Editor.FieldWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="필드(Fld) 편집"
    Width="1600"
    Height="950"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="LongCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="8">
        <StackPanel
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="찾기(번호·쓰는 곳):" />
            <TextBox
                x:Name="FilterBox"
                Width="200"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="FieldFilterBox"
                TextChanged="Filter_Changed" />
            <Button
                x:Name="SaveButton"
                Margin="12,0,0,0"
                Padding="10,2"
                AutomationProperties.AutomationId="FieldSaveButton"
                Click="Save_Click"
                Content="저장(_S)" />
            <Button
                Margin="6,0,0,0"
                Padding="10,2"
                AutomationProperties.AutomationId="FieldRevertButton"
                Click="Revert_Click"
                Content="이 필드 되돌리기" />
            <TextBlock
                x:Name="StatusText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Foreground="DimGray" />
        </StackPanel>

        <TextBlock
            Margin="0,6,0,0"
            DockPanel.Dock="Bottom"
            Foreground="DimGray"
            Text="Fld 는 걸어다니는 화면이 아니라 스크립트가 처음부터 끝까지 도는 연출 장면이다(WarOfGenesis.Assets/FieldFile.cs). 머리·물체·인물·스크립트 명령은 크기가 정해진 레코드라 제자리에서 고쳐 쓴다 — 더하거나 빼는 것은 스크립트가 열쇠·차례로 가리키고 있어 하지 않는다. 미리보기에서 물체·인물을 끌면 자리가 바뀐다. 저장하면 저장소 assets/data/Fld 에 쓰고(처음 한 번은 .bak), 게임을 다시 켜면 반영된다."
            TextWrapping="Wrap" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="640" />
            </Grid.ColumnDefinitions>

            <!--  왼쪽: 필드 목록  -->
            <DataGrid
                x:Name="FieldGrid"
                Grid.Column="0"
                AutoGenerateColumns="False"
                AutomationProperties.AutomationId="FieldGrid"
                CanUserAddRows="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                SelectionChanged="FieldGrid_SelectionChanged"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Id, StringFormat=D4}" Header="Fld" />
                    <DataGridTextColumn Binding="{Binding Background}" Header="배경" />
                    <DataGridTextColumn Binding="{Binding Bgm}" Header="BGM" />
                    <DataGridTextColumn Binding="{Binding Objects}" Header="물체" />
                    <DataGridTextColumn Binding="{Binding People}" Header="인물" />
                    <DataGridTextColumn Binding="{Binding Events}" Header="이벤트" />
                    <DataGridTextColumn
                        MaxWidth="160"
                        Binding="{Binding UsedBy}"
                        ElementStyle="{StaticResource LongCell}"
                        Header="쓰는 곳" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Stretch" />

            <!--  가운데: 미리보기  -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <TextBlock
                        x:Name="PreviewHeader"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="미리보기" />
                    <CheckBox
                        x:Name="SpritesToggle"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Checked="PreviewOption_Changed"
                        Content="그림"
                        IsChecked="True"
                        Unchecked="PreviewOption_Changed" />
                    <CheckBox
                        x:Name="LabelsToggle"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Checked="PreviewOption_Changed"
                        Content="이름표"
                        IsChecked="True"
                        Unchecked="PreviewOption_Changed" />
                    <TextBlock
                        x:Name="PreviewStatus"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="DimGray" />
                </StackPanel>
                <ScrollViewer
                    Margin="0,4,0,0"
                    Background="#202020"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <Canvas
                        x:Name="PreviewCanvas"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="FieldPreviewCanvas"
                        MouseLeftButtonUp="Preview_MouseUp"
                        MouseMove="Preview_MouseMove" />
                </ScrollViewer>
            </DockPanel>

            <GridSplitter
                Grid.Column="3"
                Width="6"
                HorizontalAlignment="Stretch" />

            <!--  오른쪽: 고치기  -->
            <TabControl
                x:Name="EditTabs"
                Grid.Column="4"
                AutomationProperties.AutomationId="FieldEditTabs"
                IsEnabled="False">
                <TabItem Header="머리">
                    <StackPanel Margin="8">
                        <WrapPanel>
                            <TextBlock
                                Width="90"
                                VerticalAlignment="Center"
                                Text="배경 Bgr" />
                            <TextBox
                                x:Name="HeadBackgroundBox"
                                Width="80"
                                AutomationProperties.AutomationId="FieldHeadBackground" />
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock
                                Width="90"
                                VerticalAlignment="Center"
                                Text="첫 화면 X, Y" />
                            <TextBox x:Name="HeadCameraXBox" Width="80" />
                            <TextBox
                                x:Name="HeadCameraYBox"
                                Width="80"
                                Margin="6,0,0,0" />
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock
                                Width="90"
                                VerticalAlignment="Center"
                                Text="BGM" />
                            <TextBox x:Name="HeadBgmBox" Width="80" />
                        </WrapPanel>
                        <Button
                            Margin="0,10,0,0"
                            Padding="10,2"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="FieldHeadApply"
                            Click="HeadApply_Click"
                            Content="머리 적용" />
                        <TextBlock
                            Margin="0,10,0,0"
                            Foreground="DimGray"
                            Text="첫 화면 자리는 미리보기의 흰 점선 틀(640×480)이다. 배경이 그보다 크면 스크립트의 400·401·402 로 화면이 움직인다."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="물체">
                    <DataGrid
                        x:Name="ObjectGrid"
                        AutoGenerateColumns="False"
                        AutomationProperties.AutomationId="FieldObjectGrid"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CellEditEnding="Grid_CellEditEnding"
                        SelectionChanged="PartGrid_SelectionChanged"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Binding="{Binding Index}"
                                Header="#"
                                IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding Key}" Header="열쇠" />
                            <DataGridTextColumn Binding="{Binding Picture}" Header="그림 Obs" />
                            <DataGridTextColumn Binding="{Binding Kind}" Header="모션" />
                            <DataGridTextColumn Binding="{Binding X}" Header="X" />
                            <DataGridTextColumn Binding="{Binding Y}" Header="Y" />
                            <DataGridTextColumn Binding="{Binding Layer}" Header="층 0~7" />
                            <DataGridTextColumn
                                Binding="{Binding Script}"
                                Header="스크립트가 부르는 번호"
                                IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="인물">
                    <DataGrid
                        x:Name="PersonGrid"
                        AutoGenerateColumns="False"
                        AutomationProperties.AutomationId="FieldPersonGrid"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CellEditEnding="Grid_CellEditEnding"
                        SelectionChanged="PartGrid_SelectionChanged"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Binding="{Binding Index}"
                                Header="#"
                                IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding Key}" Header="열쇠" />
                            <DataGridTextColumn Binding="{Binding ChrCode}" Header="Chr" />
                            <DataGridTextColumn
                                Binding="{Binding Name}"
                                Header="이름"
                                IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding X}" Header="X" />
                            <DataGridTextColumn Binding="{Binding Y}" Header="Y" />
                            <DataGridTextColumn Binding="{Binding Layer}" Header="층(−1 붙박이)" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="스크립트">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="220" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DataGrid
                            x:Name="EventGrid"
                            Grid.Row="0"
                            AutoGenerateColumns="False"
                            AutomationProperties.AutomationId="FieldEventGrid"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CellEditEnding="Grid_CellEditEnding"
                            SelectionChanged="EventGrid_SelectionChanged"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Binding="{Binding Index}"
                                    Header="이벤트"
                                    IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding MaxFire}" Header="최대 발동(0 무한)" />
                                <DataGridTextColumn
                                    Binding="{Binding Conditions}"
                                    Header="조건"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Binding="{Binding Actions}"
                                    Header="행동"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    MaxWidth="360"
                                    Binding="{Binding Summary}"
                                    ElementStyle="{StaticResource LongCell}"
                                    Header="요약"
                                    IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter
                            Grid.Row="1"
                            Height="6"
                            HorizontalAlignment="Stretch" />
                        <DataGrid
                            x:Name="CommandGrid"
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            AutomationProperties.AutomationId="FieldCommandGrid"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CellEditEnding="Grid_CellEditEnding"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Binding="{Binding Part}"
                                    Header="갈래"
                                    IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding Code}" Header="코드" />
                                <DataGridTextColumn
                                    MaxWidth="200"
                                    Binding="{Binding Name}"
                                    ElementStyle="{StaticResource LongCell}"
                                    Header="뜻"
                                    IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding A0}" Header="a0" />
                                <DataGridTextColumn Binding="{Binding A1}" Header="a1" />
                                <DataGridTextColumn Binding="{Binding A2}" Header="a2" />
                                <DataGridTextColumn Binding="{Binding A3}" Header="a3" />
                                <DataGridTextColumn Binding="{Binding A4}" Header="a4" />
                                <DataGridTextColumn Binding="{Binding A5}" Header="a5" />
                                <DataGridTextColumn Binding="{Binding A6}" Header="a6" />
                                <DataGridTextColumn Binding="{Binding A7}" Header="a7" />
                                <DataGridTextColumn
                                    MaxWidth="260"
                                    Binding="{Binding Note}"
                                    ElementStyle="{StaticResource LongCell}"
                                    Header="글·대상"
                                    IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
