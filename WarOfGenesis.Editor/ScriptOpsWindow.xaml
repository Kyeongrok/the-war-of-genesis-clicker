<Window
    x:Class="WarOfGenesis.Editor.ScriptOpsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="스크립트 명령 사전"
    Width="1500"
    Height="880"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="LongCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="8">
        <StackPanel
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="스크립트:" />
            <ComboBox
                x:Name="KindBox"
                Width="200"
                Margin="6,0,0,0"
                AutomationProperties.AutomationId="ScriptOpsKind"
                SelectionChanged="Kind_Changed">
                <ComboBoxItem Content="전투(Btl) 행동" IsSelected="True" />
                <ComboBoxItem Content="전투(Btl) 조건" />
                <ComboBoxItem Content="필드·챕터(Fld·Chp) 행동" />
                <ComboBoxItem Content="필드·챕터(Fld·Chp) 조건" />
            </ComboBox>
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Text="찾기(번호·이름·설명):" />
            <TextBox
                x:Name="FilterBox"
                Width="220"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ScriptOpsFilter"
                TextChanged="Filter_Changed" />
            <CheckBox
                x:Name="UsedOnlyToggle"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Checked="Filter_Changed"
                Content="자료에 쓰인 것만"
                Unchecked="Filter_Changed" />
            <TextBlock
                x:Name="StatusText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Foreground="DimGray" />
        </StackPanel>

        <TextBlock
            Margin="0,6,0,0"
            DockPanel.Dock="Bottom"
            Foreground="DimGray"
            Text="명령 한 줄은 18바이트 — 코드 한 워드와 인자 8워드(a0~a7)다. 대상 인자는 10000+n = 그 스크립트의 배치(인물) n, 전투에서 20000+2k = 편 k 전체 · 20001+2k = 편 k 의 누구, 그 밖은 Chr 번호. 전투 표는 옵시디안 분석-전투(조건 열여섯 개 · 행동 점프표 전수)를, 필드·챕터 표는 duel-dx 필드 실행기를 옮겼다(WarOfGenesis.Assets/BattleScript.cs · FieldScript.cs). 「쓰인 곳」은 저장소 assets 의 Btl·Fld·Chp 를 훑은 것이다. 표에 없는 코드는 이름이 「(모름)」으로 나온다."
            TextWrapping="Wrap" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="620" />
            </Grid.ColumnDefinitions>

            <DataGrid
                x:Name="OpGrid"
                Grid.Column="0"
                AutoGenerateColumns="False"
                AutomationProperties.AutomationId="ScriptOpsGrid"
                CanUserAddRows="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                SelectionChanged="OpGrid_SelectionChanged"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Code}" Header="코드" />
                    <DataGridTextColumn
                        MaxWidth="200"
                        Binding="{Binding Name}"
                        ElementStyle="{StaticResource LongCell}"
                        Header="이름" />
                    <DataGridTextColumn
                        MaxWidth="280"
                        Binding="{Binding Args}"
                        ElementStyle="{StaticResource LongCell}"
                        Header="인자" />
                    <DataGridTextColumn Binding="{Binding Uses}" Header="쓰인 수" />
                    <DataGridTextColumn Binding="{Binding Files}" Header="파일 수" />
                    <DataGridTextColumn Binding="{Binding Address}" Header="원본 주소" />
                    <DataGridTextColumn
                        MaxWidth="360"
                        Binding="{Binding Note}"
                        ElementStyle="{StaticResource LongCell}"
                        Header="설명" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Stretch" />

            <DockPanel Grid.Column="2">
                <Border
                    Padding="8"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    DockPanel.Dock="Top">
                    <StackPanel>
                        <TextBlock
                            x:Name="DetailTitle"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="명령을 고르세요" />
                        <TextBlock
                            x:Name="DetailArgs"
                            Margin="0,4,0,0"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="DetailNote"
                            Margin="0,4,0,0"
                            Foreground="#333"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock
                    Margin="0,8,0,4"
                    DockPanel.Dock="Top"
                    FontWeight="Bold"
                    Text="쓰인 곳" />
                <DataGrid
                    x:Name="UseGrid"
                    AutoGenerateColumns="False"
                    AutomationProperties.AutomationId="ScriptOpsUses"
                    CanUserAddRows="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding File}" Header="파일" />
                        <DataGridTextColumn Binding="{Binding Event}" Header="이벤트" />
                        <DataGridTextColumn Binding="{Binding Line}" Header="줄" />
                        <DataGridTextColumn Binding="{Binding A0}" Header="a0" />
                        <DataGridTextColumn Binding="{Binding A1}" Header="a1" />
                        <DataGridTextColumn Binding="{Binding A2}" Header="a2" />
                        <DataGridTextColumn Binding="{Binding A3}" Header="a3" />
                        <DataGridTextColumn Binding="{Binding A4}" Header="a4" />
                        <DataGridTextColumn Binding="{Binding A5}" Header="a5" />
                        <DataGridTextColumn Binding="{Binding A6}" Header="a6" />
                        <DataGridTextColumn Binding="{Binding A7}" Header="a7" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
