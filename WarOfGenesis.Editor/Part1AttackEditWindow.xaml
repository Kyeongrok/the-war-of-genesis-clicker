<Window
    x:Class="WarOfGenesis.Editor.Part1AttackEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="파트1 기술 편집 — Attack.dat (고친 것은 assets/data/part1-attacks/*.json)"
    Width="1240"
    Height="720"
    WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <!--  위: 어빌리티 고르기 · 이름 찾기  -->
        <StackPanel Margin="0,0,0,6" DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="어빌리티 " />
            <ComboBox
                x:Name="AbilityBox"
                Width="240"
                AutomationProperties.AutomationId="Part1AttackAbility"
                SelectionChanged="Filter_Changed" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="이름 " />
            <TextBox
                x:Name="SearchBox"
                Width="160"
                AutomationProperties.AutomationId="Part1AttackSearch"
                TextChanged="Filter_Changed" />
            <TextBlock
                x:Name="LegendText"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Foreground="#2B4C7E"
                TextWrapping="Wrap" />
        </StackPanel>
        <!--  아래: 저장·되돌리기·상태 글  -->
        <DockPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
            <Button
                x:Name="SaveButton"
                Margin="0,0,6,0"
                Padding="12,3"
                AutomationProperties.AutomationId="Part1AttackSave"
                Click="Save_Click"
                Content="저장"
                DockPanel.Dock="Left" />
            <Button
                x:Name="RevertButton"
                Padding="12,3"
                AutomationProperties.AutomationId="Part1AttackRevert"
                Click="Revert_Click"
                Content="고른 레벨 원본으로"
                DockPanel.Dock="Left" />
            <TextBlock
                x:Name="StatusText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Part1AttackStatus"
                TextWrapping="Wrap" />
        </DockPanel>
        <DataGrid
            x:Name="AttackGrid"
            AutoGenerateColumns="False"
            AutomationProperties.AutomationId="Part1AttackList"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CellEditEnding="AttackGrid_CellEditEnding"
            HeadersVisibility="Column"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Mark, Mode=OneWay}" Header="" IsReadOnly="True" />
                <DataGridTextColumn Binding="{Binding Id, Mode=OneWay}" Header="번호" IsReadOnly="True" />
                <DataGridTextColumn Binding="{Binding Name, Mode=OneWay}" Header="이름" IsReadOnly="True" Width="170" />
                <DataGridTextColumn Binding="{Binding Level, Mode=OneWay}" Header="레벨" IsReadOnly="True" />
                <DataGridTextColumn Binding="{Binding Formula}" Header="세기 식" />
                <DataGridTextColumn Binding="{Binding FormulaText, Mode=OneWay}" Header="식 뜻" IsReadOnly="True" />
                <DataGridTextColumn Binding="{Binding PowerAdd}" Header="더하는 세기" />
                <DataGridTextColumn Binding="{Binding DamagePercent}" Header="피해 %" />
                <DataGridTextColumn Binding="{Binding Accuracy}" Header="명중률" />
                <DataGridTextColumn Binding="{Binding Hits}" Header="타수" />
                <DataGridTextColumn Binding="{Binding Element}" Header="속성" />
                <DataGridTextColumn Binding="{Binding Element2}" Header="둘째 속성" />
                <DataGridTextColumn Binding="{Binding Cost}" Header="소울" />
                <DataGridTextColumn Binding="{Binding Summary, Mode=OneWay}" Header="지금 값" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
