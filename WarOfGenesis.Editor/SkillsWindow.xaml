<Window
    x:Class="WarOfGenesis.Editor.SkillsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="스킬(어빌리티)"
    Width="1400"
    Height="800"
    WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <StackPanel
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="찾기(이름·번호·직업):" />
            <TextBox
                x:Name="FilterBox"
                Width="220"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="SkillsFilterBox"
                TextChanged="FilterBox_TextChanged" />
            <CheckBox
                x:Name="LevelsToggle"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Checked="FilterBox_TextChanged"
                Content="레벨마다 한 줄 (끄면 Lv1 만)"
                IsChecked="True"
                Unchecked="FilterBox_TextChanged" />
            <TextBlock
                x:Name="StatusText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Foreground="DimGray" />
        </StackPanel>

        <TextBlock
            Margin="0,6,0,0"
            DockPanel.Dock="Bottom"
            Foreground="DimGray"
            Text="Abi 레코드 × 레벨별 work(Dat/*.att). 종류: 피해 · 회복 · 보조 · 오브젝트. 위력 = 피해면 공격력 ×(200+값)/2000, 회복이면 최대 HP %. 치명 % = 값+1. TP = 기본 + 체질 항(체질마다 다름). 사거리 모양 1 마름모 · 2 십자 · 0 제자리(뜻은 가설). 대상: 1·4·5 = 한 명, 그 밖 = 효과 범위 안 모두."
            TextWrapping="Wrap" />

        <DataGrid
            x:Name="Grid"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            FrozenColumnCount="3"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            IsReadOnly="True"
            VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding AbilityId, StringFormat=D4}" Header="Abi" />
                <DataGridTextColumn Binding="{Binding Name}" Header="이름" />
                <DataGridTextColumn Binding="{Binding Level}" Header="Lv" />
                <DataGridTextColumn Binding="{Binding MaxLevel}" Header="최대" />
                <DataGridTextColumn Binding="{Binding WorkId}" Header="work" />
                <DataGridTextColumn Binding="{Binding Kind}" Header="종류" />
                <DataGridTextColumn Binding="{Binding Power}" Header="위력" />
                <DataGridTextColumn Binding="{Binding Accuracy}" Header="명중" />
                <DataGridTextColumn Binding="{Binding Critical}" Header="치명 %" />
                <DataGridTextColumn Binding="{Binding Range}" Header="사거리" />
                <DataGridTextColumn Binding="{Binding Target}" Header="대상" />
                <DataGridTextColumn Binding="{Binding Area}" Header="효과 범위" />
                <DataGridTextColumn Binding="{Binding Tp}" Header="TP" />
                <DataGridTextColumn Binding="{Binding Soul}" Header="SOUL" />
                <DataGridTextColumn Binding="{Binding Exp}" Header="다음 Lv EXP" />
                <DataGridTextColumn Binding="{Binding Jobs}" Header="배우는 직업" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
