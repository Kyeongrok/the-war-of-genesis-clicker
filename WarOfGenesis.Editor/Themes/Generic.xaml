<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WarOfGenesis.Editor.Controls">

    <!--  NumericSpinner — mv-data-view 의 것을 밝은 편집기 화면 색으로 옮겼다.  -->
    <SolidColorBrush x:Key="Spin.Border" Color="#ABADB3" />
    <SolidColorBrush x:Key="Spin.Accent" Color="#3C7FB1" />
    <SolidColorBrush x:Key="Spin.Button" Color="#F0F0F0" />
    <SolidColorBrush x:Key="Spin.ButtonHover" Color="#E0ECF8" />
    <SolidColorBrush x:Key="Spin.Arrow" Color="#505050" />

    <Style x:Key="SpinButtonStyle" TargetType="RepeatButton">
        <Setter Property="Delay" Value="400" />
        <Setter Property="Interval" Value="60" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{StaticResource Spin.Button}" />
        <Setter Property="Foreground" Value="{StaticResource Spin.Arrow}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Spin.ButtonHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Spin.Accent}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:NumericSpinner}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NumericSpinner}">
                    <Border
                        x:Name="OuterBorder"
                        Background="White"
                        BorderBrush="{StaticResource Spin.Border}"
                        BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBox
                                x:Name="PART_TextBox"
                                Grid.RowSpan="2"
                                Padding="2,0"
                                VerticalContentAlignment="Center"
                                BorderThickness="0"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}" />
                            <RepeatButton
                                x:Name="PART_UpButton"
                                Grid.Column="1"
                                Style="{StaticResource SpinButtonStyle}">
                                <Path
                                    Width="7"
                                    Height="4"
                                    Data="M0,5 L4,0 L8,5 Z"
                                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                                    Stretch="Fill" />
                            </RepeatButton>
                            <RepeatButton
                                x:Name="PART_DownButton"
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource SpinButtonStyle}">
                                <Path
                                    Width="7"
                                    Height="4"
                                    Data="M0,0 L8,0 L4,5 Z"
                                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                                    Stretch="Fill" />
                            </RepeatButton>
                            <Border
                                Grid.Column="1"
                                Grid.RowSpan="2"
                                BorderBrush="{StaticResource Spin.Border}"
                                BorderThickness="1,0,0,0"
                                IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="PART_TextBox" Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource Spin.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
