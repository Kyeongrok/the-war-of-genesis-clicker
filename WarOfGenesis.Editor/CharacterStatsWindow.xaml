<Window
    x:Class="WarOfGenesis.Editor.CharacterStatsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="캐릭터 스탯"
    Width="1400"
    Height="800"
    WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <StackPanel
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="찾기(이름·칭호·직업·번호):" />
            <TextBox
                x:Name="FilterBox"
                Width="220"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="StatsFilterBox"
                TextChanged="FilterBox_TextChanged" />
            <CheckBox
                x:Name="HideEmptyToggle"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Checked="FilterBox_TextChanged"
                Content="이름 없는·자리표시 레코드 숨기기"
                IsChecked="True"
                Unchecked="FilterBox_TextChanged" />
            <TextBlock
                x:Name="StatusText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Foreground="DimGray" />
        </StackPanel>

        <TextBlock
            Margin="0,6,0,0"
            DockPanel.Dock="Bottom"
            Foreground="DimGray"
            Text="값은 .chr 파일 기본값 + 장비 보너스(G3PartII.dll 식). HP 는 갑옷 배율을 곱한 화면 값이고, 어빌리티 패시브 보너스는 아직 안 넣었다. SOUL 은 전투 시작값/최대. ATK·ACR 은 시작 SOUL·가득 찬 TP 기준."
            TextWrapping="Wrap" />

        <DataGrid
            x:Name="Grid"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            FrozenColumnCount="2"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            IsReadOnly="True"
            VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Code, StringFormat=D4}" Header="Chr" />
                <DataGridTextColumn Binding="{Binding Name}" Header="이름" />
                <DataGridTextColumn Binding="{Binding Title}" Header="칭호" />
                <DataGridTextColumn Binding="{Binding Body}" Header="체질" />
                <DataGridTextColumn Binding="{Binding Family}" Header="계열" />
                <DataGridTextColumn Binding="{Binding Job}" Header="직업" />
                <DataGridTextColumn Binding="{Binding Level}" Header="LV" />
                <DataGridTextColumn Binding="{Binding Hp}" Header="HP" />
                <DataGridTextColumn Binding="{Binding Soul}" Header="SOUL" />
                <DataGridTextColumn Binding="{Binding Tp}" Header="TP" />
                <DataGridTextColumn Binding="{Binding Atk}" Header="ATK" />
                <DataGridTextColumn Binding="{Binding Acr}" Header="ACR" />
                <DataGridTextColumn Binding="{Binding Rdp}" Header="RDP" />
                <DataGridTextColumn Binding="{Binding Lp}" Header="LP" />
                <DataGridTextColumn Binding="{Binding Ctp}" Header="CTP" />
                <DataGridTextColumn Binding="{Binding Stp}" Header="STP" />
                <DataGridTextColumn Binding="{Binding Psy}" Header="PSY" />
                <DataGridTextColumn Binding="{Binding Dep}" Header="DEP" />
                <DataGridTextColumn Binding="{Binding Dex}" Header="DEX" />
                <DataGridTextColumn Binding="{Binding Weapon}" Header="무기" />
                <DataGridTextColumn Binding="{Binding Equipment}" Header="장비" />
                <DataGridTextColumn Binding="{Binding Abilities}" Header="어빌리티 (레벨, 다음 레벨 EXP)" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
