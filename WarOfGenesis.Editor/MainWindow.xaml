<Window
    x:Class="WarOfGenesis.Editor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WarOfGenesis.Editor"
    Title="WarOfGenesis Editor"
    Width="1150"
    Height="720"
    WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="요소(_E)">
                <MenuItem
                    x:Name="JobViewerMenuItem"
                    AutomationProperties.AutomationId="JobViewerMenuItem"
                    Click="JobViewerMenuItem_Click"
                    Header="직업(_J)" />
                <MenuItem
                    x:Name="BattleListMenuItem"
                    AutomationProperties.AutomationId="BattleListMenuItem"
                    Click="BattleListMenuItem_Click"
                    Header="전투 목록(챕터별)(_L)" />
                <MenuItem
                    x:Name="ChapterMenuItem"
                    AutomationProperties.AutomationId="ChapterMenuItem"
                    Click="ChapterMenuItem_Click"
                    Header="챕터(모세스)(_M)" />
                <MenuItem
                    x:Name="FieldMenuItem"
                    AutomationProperties.AutomationId="FieldMenuItem"
                    Click="FieldMenuItem_Click"
                    Header="필드(Fld)(_F)" />
                <MenuItem
                    x:Name="ScriptOpsMenuItem"
                    AutomationProperties.AutomationId="ScriptOpsMenuItem"
                    Click="ScriptOpsMenuItem_Click"
                    Header="스크립트 명령 사전(_S)" />
                <MenuItem
                    x:Name="EffectViewerMenuItem"
                    AutomationProperties.AutomationId="EffectViewerMenuItem"
                    Click="EffectViewerMenuItem_Click"
                    Header="이펙트 보기(_E)" />
            </MenuItem>
            <MenuItem Header="어빌리티(_B)">
                <MenuItem
                    x:Name="SkillEditMenuItem"
                    AutomationProperties.AutomationId="SkillEditMenuItem"
                    Click="SkillEditMenuItem_Click"
                    Header="스킬(_K)" />
                <MenuItem
                    x:Name="BodyAbilitiesMenuItem"
                    AutomationProperties.AutomationId="BodyAbilitiesMenuItem"
                    Click="BodyAbilitiesMenuItem_Click"
                    Header="체질 — 배울 수 있는 어빌리티(_B)" />
            </MenuItem>
            <MenuItem Header="에셋(_A)">
                <MenuItem
                    x:Name="MusicMenuItem"
                    AutomationProperties.AutomationId="MusicMenuItem"
                    Click="MusicMenuItem_Click"
                    Header="배경음악(_B)" />
                <MenuItem
                    x:Name="EffectSoundMenuItem"
                    AutomationProperties.AutomationId="EffectSoundMenuItem"
                    Click="EffectSoundMenuItem_Click"
                    Header="효과음(_S)" />
                <MenuItem
                    x:Name="VoiceMenuItem"
                    AutomationProperties.AutomationId="VoiceMenuItem"
                    Click="VoiceMenuItem_Click"
                    Header="인물 대사(_V)" />
            </MenuItem>
            <MenuItem
                x:Name="BattleMapMenuItem"
                AutomationProperties.AutomationId="BattleMapMenuItem"
                Click="BattleMapMenuItem_Click"
                Header="맵(_M)" />
        </Menu>

        <DockPanel Margin="8">

            <!--  위: 게임 폴더  -->
            <StackPanel Margin="0,0,0,8" DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Width="70"
                        VerticalAlignment="Center"
                        Text="게임 폴더:" />
                    <TextBox
                        x:Name="GameRootBox"
                        Width="480"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="GameRootBox" />
                    <Button
                        x:Name="BrowseButton"
                        Width="70"
                        Margin="6,0,0,0"
                        Click="BrowseButton_Click"
                        Content="찾기..." />
                    <Button
                        x:Name="LoadButton"
                        Width="90"
                        Margin="6,0,0,0"
                        AutomationProperties.AutomationId="LoadButton"
                        Click="LoadButton_Click"
                        Content="이 폴더 열기" />
                </StackPanel>
            </StackPanel>

            <!--  아래: 상태 줄  -->
            <TextBlock
                x:Name="StatusText"
                Margin="0,6,0,0"
                DockPanel.Dock="Bottom"
                Foreground="DimGray"
                TextWrapping="Wrap" />

            <!--  가운데: 캐릭터 스탯(첫 화면)  -->
            <local:CharacterStatsView x:Name="Stats" />
        </DockPanel>
    </DockPanel>
</Window>
