<Window
    x:Class="WarOfGenesis.Editor.EffectViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="이펙트 보기"
    Width="1500"
    Height="900"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="LongCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="8">
        <TextBlock
            Margin="0,6,0,0"
            DockPanel.Dock="Bottom"
            Foreground="DimGray"
            Text="이펙트는 Obs 의 모션을 30틱/초로 그린다 — 그림 키·자식 키(다른 Obs 를 겹침)·섞기 키(17 더하기 · 10 닷지 · 12 스크린 · 1~8 밝기 단계)·자리 키를 원본 애니메이터처럼 따른다. 「assets」 가 ✗ 인 Obs 는 저장소 assets 에 없어 게임(duel-dx)에서 안 나온다 — 게임 폴더를 열어 두면 게임 자료로 미리 볼 수 있다. 기술 탭의 목록은 tools/re/work_fx_extra.tsv(원본 준비·핸들러가 띄우는 것 전부와 호출 주소)다. 「게임 표」 가 ○ 면 duel-dx 가 그 기술에 실제로 띄우는 표(AbilityScripts.g.cs)에도 있고, ✗ 면 게임에서 빠져 있다. duel-dx 가 손으로 만든 기술(나인 크루세이더의 칼, 필살기 앞머리 등)은 따로 그린다. 종류 obs? 는 Obs·모션을 셈으로 정하는 것, code 는 그림 자료 없이 코드로 그리는 것, sound 는 소리만 든 껍데기다."
            TextWrapping="Wrap" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="560" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TabControl x:Name="Tabs" Grid.Column="0">
                <TabItem Header="기술로 찾기">
                    <DockPanel>
                        <StackPanel
                            Margin="0,4"
                            DockPanel.Dock="Top"
                            Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="찾기(이름·번호):" />
                            <TextBox
                                x:Name="SkillFilterBox"
                                Width="180"
                                Margin="6,0,0,0"
                                AutomationProperties.AutomationId="EffectSkillFilter"
                                TextChanged="SkillFilter_Changed" />
                        </StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DataGrid
                                x:Name="WorkGrid"
                                Grid.Row="0"
                                AutoGenerateColumns="False"
                                AutomationProperties.AutomationId="EffectWorkGrid"
                                CanUserAddRows="False"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                SelectionChanged="WorkGrid_SelectionChanged"
                                SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Ability}" Header="어빌" />
                                    <DataGridTextColumn
                                        MaxWidth="160"
                                        Binding="{Binding Name}"
                                        ElementStyle="{StaticResource LongCell}"
                                        Header="이름" />
                                    <DataGridTextColumn Binding="{Binding Level}" Header="Lv" />
                                    <DataGridTextColumn Binding="{Binding Work}" Header="work" />
                                    <DataGridTextColumn Binding="{Binding Prepare}" Header="준비" />
                                    <DataGridTextColumn Binding="{Binding Effects}" Header="이펙트" />
                                    <DataGridTextColumn Binding="{Binding Missing}" Header="assets 에 없음" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <GridSplitter
                                Grid.Row="1"
                                Height="6"
                                HorizontalAlignment="Stretch" />
                            <DockPanel Grid.Row="2">
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock
                                        x:Name="WorkInfo"
                                        Margin="0,2"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Margin="0,2"
                                        Padding="8,2"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.AutomationId="EffectPlayWork"
                                        Click="PlayWork_Click"
                                        Content="이 기술의 이펙트를 모두 겹쳐 재생" />
                                </StackPanel>
                                <DataGrid
                                    x:Name="EffectGrid"
                                    AutoGenerateColumns="False"
                                    AutomationProperties.AutomationId="EffectListGrid"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    SelectionChanged="EffectGrid_SelectionChanged"
                                    SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Part}" Header="갈래" />
                                        <DataGridTextColumn Binding="{Binding Kind}" Header="종류" />
                                        <DataGridTextColumn Binding="{Binding Obs}" Header="Obs" />
                                        <DataGridTextColumn Binding="{Binding Motion}" Header="모션" />
                                        <DataGridTextColumn Binding="{Binding Where}" Header="자리" />
                                        <DataGridTextColumn Binding="{Binding Delay}" Header="시작 지연" />
                                        <DataGridTextColumn Binding="{Binding Life}" Header="수명" />
                                        <DataGridTextColumn Binding="{Binding InAssets}" Header="assets" />
                                        <DataGridTextColumn Binding="{Binding InGame}" Header="게임 표" />
                                        <DataGridTextColumn
                                            MaxWidth="160"
                                            Binding="{Binding Note}"
                                            ElementStyle="{StaticResource LongCell}"
                                            Header="비고" />
                                        <DataGridTextColumn Binding="{Binding Address}" Header="호출 주소" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Obs 로 찾기">
                    <DockPanel>
                        <StackPanel
                            Margin="0,4"
                            DockPanel.Dock="Top"
                            Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Obs 번호:" />
                            <TextBox
                                x:Name="ObsFilterBox"
                                Width="100"
                                Margin="6,0,0,0"
                                AutomationProperties.AutomationId="EffectObsFilter"
                                TextChanged="ObsFilter_Changed" />
                            <CheckBox
                                x:Name="MissingOnlyToggle"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Checked="ObsFilter_Changed"
                                Content="assets 에 없는 것만"
                                Unchecked="ObsFilter_Changed" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DataGrid
                                x:Name="ObsGrid"
                                Grid.Column="0"
                                AutoGenerateColumns="False"
                                AutomationProperties.AutomationId="EffectObsGrid"
                                CanUserAddRows="False"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                SelectionChanged="ObsGrid_SelectionChanged"
                                SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Obs}" Header="Obs" />
                                    <DataGridTextColumn Binding="{Binding Where}" Header="자리" />
                                    <DataGridTextColumn Binding="{Binding InAssets}" Header="assets" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid
                                x:Name="MotionGrid"
                                Grid.Column="1"
                                AutoGenerateColumns="False"
                                AutomationProperties.AutomationId="EffectMotionGrid"
                                CanUserAddRows="False"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                SelectionChanged="MotionGrid_SelectionChanged"
                                SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Motion}" Header="모션" />
                                    <DataGridTextColumn Binding="{Binding Length}" Header="길이" />
                                    <DataGridTextColumn Binding="{Binding Keys}" Header="그림 키" />
                                    <DataGridTextColumn Binding="{Binding Children}" Header="자식" />
                                    <DataGridTextColumn Binding="{Binding Blends}" Header="섞기" />
                                    <DataGridTextColumn Binding="{Binding Sounds}" Header="소리" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Stretch" />

            <DockPanel Grid.Column="2">
                <StackPanel
                    Margin="0,0,0,6"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal">
                    <Button
                        x:Name="PlayButton"
                        Padding="10,2"
                        AutomationProperties.AutomationId="EffectPlayPause"
                        Click="PlayPause_Click"
                        Content="⏸ 멈춤" />
                    <Button
                        Margin="4,0,0,0"
                        Padding="8,2"
                        Click="StepBack_Click"
                        Content="◀ 한 틱" />
                    <Button
                        Margin="4,0,0,0"
                        Padding="8,2"
                        Click="StepForward_Click"
                        Content="한 틱 ▶" />
                    <Button
                        Margin="4,0,0,0"
                        Padding="8,2"
                        Click="Restart_Click"
                        Content="처음부터" />
                    <CheckBox
                        x:Name="LoopToggle"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Content="되풀이"
                        IsChecked="True" />
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Text="바탕:" />
                    <ComboBox
                        x:Name="BackgroundBox"
                        Width="90"
                        Margin="4,0,0,0"
                        SelectionChanged="Background_Changed">
                        <ComboBoxItem Content="검정" IsSelected="True" />
                        <ComboBoxItem Content="회색" />
                        <ComboBoxItem Content="흙색" />
                    </ComboBox>
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Text="배율:" />
                    <ComboBox
                        x:Name="ZoomBox"
                        Width="60"
                        Margin="4,0,0,0"
                        SelectionChanged="Zoom_Changed">
                        <ComboBoxItem Content="1×" IsSelected="True" />
                        <ComboBoxItem Content="2×" />
                    </ComboBox>
                    <TextBlock
                        x:Name="TickText"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="Consolas" />
                </StackPanel>
                <TextBlock
                    x:Name="PreviewInfo"
                    Margin="0,0,0,6"
                    DockPanel.Dock="Top"
                    Foreground="DimGray"
                    TextWrapping="Wrap" />
                <ScrollViewer
                    Background="#101010"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <Image
                        x:Name="PreviewImage"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="EffectPreviewImage"
                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                        Stretch="None" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
