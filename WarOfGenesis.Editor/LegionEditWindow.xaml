<Window
    x:Class="WarOfGenesis.Editor.LegionEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="군단 편집 — For.dat (고친 것은 assets/data/legions/*.json)"
    Width="1060"
    Height="700"
    WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <!--  아래: 저장·되돌리기·상태 글  -->
        <DockPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
            <Button
                x:Name="SaveButton"
                Margin="0,0,6,0"
                Padding="12,3"
                AutomationProperties.AutomationId="LegionEditSave"
                Click="Save_Click"
                Content="저장"
                DockPanel.Dock="Left" />
            <Button
                x:Name="RevertButton"
                Padding="12,3"
                AutomationProperties.AutomationId="LegionEditRevert"
                Click="Revert_Click"
                Content="이 군단 원본으로"
                DockPanel.Dock="Left" />
            <TextBlock
                x:Name="StatusText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="LegionEditStatus" />
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  왼쪽: 군단 목록  -->
            <DataGrid
                x:Name="LegionGrid"
                Grid.Column="0"
                AutoGenerateColumns="False"
                AutomationProperties.AutomationId="LegionEditList"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                IsReadOnly="True"
                SelectionChanged="LegionGrid_SelectionChanged"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Mark}" Header="" />
                    <DataGridTextColumn Binding="{Binding Id}" Header="번호" />
                    <DataGridTextColumn Binding="{Binding Name}" Header="이름" />
                    <DataGridTextColumn Binding="{Binding MembersText}" Header="부하" Width="*" />
                    <DataGridTextColumn Binding="{Binding Battles}" Header="전투" />
                </DataGrid.Columns>
            </DataGrid>
            <!--  오른쪽: 고른 군단  -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Detail" IsEnabled="False">
                    <TextBlock
                        x:Name="TitleText"
                        Margin="0,0,0,2"
                        FontSize="16"
                        FontWeight="Bold" />
                    <TextBlock
                        x:Name="DescriptionText"
                        Margin="0,0,0,8"
                        Foreground="#2B4C7E"
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="330">
                            <TextBlock FontWeight="Bold" Text="진형" />
                            <ComboBox
                                x:Name="FormationBox"
                                Margin="0,2,0,8"
                                AutomationProperties.AutomationId="LegionEditFormation"
                                SelectionChanged="FormationBox_SelectionChanged" />
                            <TextBlock FontWeight="Bold" Text="리더 (0 이면 전투 자료대로)" />
                            <StackPanel x:Name="LeaderPanel" Margin="0,2,0,0" />
                            <TextBlock
                                x:Name="BattleLeadersText"
                                Margin="18,0,0,8"
                                Foreground="Gray"
                                TextWrapping="Wrap" />
                            <TextBlock FontWeight="Bold" Text="부하 (진형 자리 1~6 차례, 비우면 없음 — 「고르기…」로 인물을 보며 고른다)" />
                            <StackPanel x:Name="MembersPanel" Margin="0,2,0,8" />
                        </StackPanel>
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock FontWeight="Bold" Text="진형 미리보기 (위를 볼 때, ★ 대장)" />
                            <Canvas
                                x:Name="FormationCanvas"
                                Width="175"
                                Height="175"
                                Margin="0,4,0,0"
                                Background="#F4F6FA" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock FontWeight="Bold" Text="부하 능력치 보정 — 부하마다 대장 세력 × 보정 ÷ 100 을 더한다 (세력 1000 이면 ×10)" />
                    <StackPanel Margin="0,2,0,8" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="LP " />
                        <TextBox x:Name="LpBox" Width="60" AutomationProperties.AutomationId="LegionEditLp" LostFocus="Bonus_LostFocus" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="PSY " />
                        <TextBox x:Name="PsyBox" Width="60" AutomationProperties.AutomationId="LegionEditPsy" LostFocus="Bonus_LostFocus" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="DEP " />
                        <TextBox x:Name="DepBox" Width="60" AutomationProperties.AutomationId="LegionEditDep" LostFocus="Bonus_LostFocus" />
                        <TextBlock
                            x:Name="BonusHint"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="Gray" />
                    </StackPanel>

                    <TextBlock FontWeight="Bold" Text="군단기 (어빌리티 · 필요 세력 · 대장 — 대장이 0 이면 누구나)" />
                    <StackPanel x:Name="SkillsPanel" Margin="0,2,0,8" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
