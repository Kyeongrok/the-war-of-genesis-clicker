<Window
    x:Class="WarOfGenesis.Editor.SoundWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="에셋 — 소리(배경음악 · 효과음 · 인물 대사)"
    Width="1100"
    Height="760"
    Closed="Window_Closed"
    WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <StackPanel
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="찾기(번호·이름·대사):" />
            <TextBox
                x:Name="FilterBox"
                Width="260"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="SoundFilterBox"
                TextChanged="FilterBox_TextChanged" />
            <TextBlock
                x:Name="StatusText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Foreground="DimGray" />
        </StackPanel>

        <!--  아래: 재생 막대  -->
        <Border
            Margin="0,8,0,0"
            Padding="6"
            BorderBrush="LightGray"
            BorderThickness="1"
            DockPanel.Dock="Bottom">
            <StackPanel>
                <TextBlock
                    x:Name="NowPlayingText"
                    Margin="0,0,0,6"
                    FontWeight="Bold"
                    Text="고른 파일 없음" />
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button
                            x:Name="PlayButton"
                            Width="70"
                            AutomationProperties.AutomationId="SoundPlayButton"
                            Click="PlayButton_Click"
                            Content="▶ 재생" />
                        <Button
                            x:Name="PauseButton"
                            Width="80"
                            Margin="6,0,0,0"
                            AutomationProperties.AutomationId="SoundPauseButton"
                            Click="PauseButton_Click"
                            Content="❚❚ 일시정지" />
                        <Button
                            x:Name="StopButton"
                            Width="70"
                            Margin="6,0,0,0"
                            AutomationProperties.AutomationId="SoundStopButton"
                            Click="StopButton_Click"
                            Content="■ 정지" />
                        <CheckBox
                            x:Name="LoopToggle"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="SoundLoopToggle"
                            Checked="LoopToggle_Changed"
                            Content="반복"
                            Unchecked="LoopToggle_Changed" />
                    </StackPanel>
                    <StackPanel
                        Margin="12,0,0,0"
                        DockPanel.Dock="Right"
                        Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="음량" />
                        <Slider
                            x:Name="VolumeSlider"
                            Width="110"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="SoundVolumeSlider"
                            Maximum="100"
                            Minimum="0"
                            ValueChanged="VolumeSlider_ValueChanged"
                            Value="80" />
                        <TextBlock
                            x:Name="VolumeText"
                            Width="36"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Text="80%" />
                    </StackPanel>
                    <TextBlock
                        x:Name="TimeText"
                        Width="100"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        Text="0:00 / 0:00"
                        TextAlignment="Right" />
                    <Slider
                        x:Name="PositionSlider"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="SoundPositionSlider"
                        IsMoveToPointEnabled="True"
                        Maximum="1"
                        Minimum="0"
                        PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="PositionSlider_PreviewMouseLeftButtonUp" />
                </DockPanel>
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
            <TabItem x:Name="MusicTab" Header="배경음악">
                <DockPanel>
                    <TextBlock
                        Margin="0,4,0,0"
                        DockPanel.Dock="Bottom"
                        Foreground="DimGray"
                        Text="BGM\NNNN.bgm (Bink 1 'BIKi', 15fps 빈 영상 + 소리 한 갈래) 중 스테레오인 것. 스크립트 음악 명령(512)이 쓰는 곡은 0019~0063 · 3390 · 3392~3394, 3480~3487 은 스크립트 소리 명령(500/501)이 트는 짧은 효과음이다. 두 번 누르면 재생."
                        TextWrapping="Wrap" />
                    <DataGrid
                        x:Name="MusicGrid"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        MouseDoubleClick="Grid_MouseDoubleClick"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Id, StringFormat=D4}" Header="번호" />
                            <DataGridTextColumn Binding="{Binding Length}" Header="길이" />
                            <DataGridTextColumn Binding="{Binding Format}" Header="형식" />
                            <DataGridTextColumn Binding="{Binding SizeText}" Header="크기" />
                            <DataGridTextColumn Binding="{Binding FileName}" Header="파일" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Source}"
                                Header="비고" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="EffectTab" Header="효과음">
                <DockPanel>
                    <TextBlock
                        Margin="0,4,0,0"
                        DockPanel.Dock="Bottom"
                        Foreground="DimGray"
                        Text="Snd\NNNN.snd — Snd.idx 로 Snd00~02.pak 에 묶인 800개(폴더의 낱장 141개는 같은 파일 사본). 속은 PCM WAV. 두 번 누르면 재생."
                        TextWrapping="Wrap" />
                    <DataGrid
                        x:Name="EffectGrid"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        MouseDoubleClick="Grid_MouseDoubleClick"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Id, StringFormat=D4}" Header="번호" />
                            <DataGridTextColumn Binding="{Binding Length}" Header="길이" />
                            <DataGridTextColumn Binding="{Binding Format}" Header="형식" />
                            <DataGridTextColumn Binding="{Binding SizeText}" Header="크기" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding FileName}"
                                Header="파일" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="VoiceTab" Header="인물 대사">
                <DockPanel>
                    <TextBlock
                        x:Name="VoiceHelpText"
                        Margin="0,4,0,0"
                        DockPanel.Dock="Bottom"
                        Foreground="DimGray"
                        Text="BGM\NNNN.bgm 중 모노인 것(음성)."
                        TextWrapping="Wrap" />
                    <DataGrid
                        x:Name="VoiceGrid"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        MouseDoubleClick="Grid_MouseDoubleClick"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Id, StringFormat=D4}" Header="번호" />
                            <DataGridTextColumn Binding="{Binding Length}" Header="길이" />
                            <DataGridTextColumn Binding="{Binding SizeText}" Header="크기" />
                            <DataGridTextColumn Binding="{Binding Speaker}" Header="말하는 이" />
                            <DataGridTextColumn Binding="{Binding Source}" Header="대사 위치" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Text}"
                                Header="대사">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
