<Window
    x:Class="WarOfGenesis.Editor.BattleMapWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WarOfGenesis Editor — 전투맵 보기"
    Width="880"
    Height="900"
    WindowStartupLocation="CenterScreen">
    <DockPanel Margin="8">
        <TextBlock
            x:Name="StatusText"
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            Foreground="DimGray"
            TextWrapping="Wrap" />

        <Border
            Background="#FF14100C"
            BorderBrush="Gray"
            BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas
                    x:Name="Board"
                    Width="800"
                    Height="800" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
