<Window
    x:Class="WarOfGenesis.Editor.BattleMapWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WarOfGenesis Editor — 전투 보기"
    Width="1700"
    Height="1000"
    WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="460" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock
                Margin="0,0,0,4"
                DockPanel.Dock="Top"
                FontWeight="Bold"
                Text="전투(Btl) · 맵(Obt)" />
            <TextBox
                x:Name="FilterBox"
                Margin="0,0,0,4"
                AutomationProperties.AutomationId="MapFilterBox"
                DockPanel.Dock="Top"
                TextChanged="Filter_Changed" />
            <CheckBox
                x:Name="ShowBareMapsToggle"
                Margin="0,0,0,4"
                Checked="Filter_Changed"
                Content="전투에 안 쓰인 맵(Obt)도 보이기"
                DockPanel.Dock="Top"
                IsChecked="True"
                Unchecked="Filter_Changed" />
            <TextBlock
                x:Name="ListStatus"
                Margin="0,0,0,4"
                DockPanel.Dock="Top"
                Foreground="DimGray" />
            <ListBox
                x:Name="MapList"
                AutomationProperties.AutomationId="MapList"
                SelectionChanged="MapList_SelectionChanged" />
        </DockPanel>

        <DockPanel Grid.Column="1">
            <StackPanel
                Margin="0,0,0,6"
                DockPanel.Dock="Top"
                Orientation="Horizontal">
                <CheckBox
                    x:Name="GridToggle"
                    Margin="0,0,12,0"
                    Checked="View_Changed"
                    Content="격자"
                    Unchecked="View_Changed" />
                <CheckBox
                    x:Name="UnitsToggle"
                    Margin="0,0,12,0"
                    Checked="View_Changed"
                    Content="인물·배치 칸"
                    IsChecked="True"
                    Unchecked="View_Changed" />
                <CheckBox
                    x:Name="AnimateToggle"
                    Margin="0,0,12,0"
                    AutomationProperties.AutomationId="BattleAnimateToggle"
                    Checked="Animate_Changed"
                    Content="서기 모션 재생(30틱/초)"
                    IsChecked="True"
                    Unchecked="Animate_Changed" />
                <TextBlock x:Name="SpriteStatus" Foreground="DimGray" />
            </StackPanel>
            <TextBlock
                x:Name="StatusText"
                MaxHeight="160"
                Margin="0,0,0,8"
                DockPanel.Dock="Top"
                TextWrapping="Wrap" />
            <Border
                Background="#FF14100C"
                BorderBrush="Gray"
                BorderThickness="1">
                <ScrollViewer
                    x:Name="BoardScroll"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="Board" ClipToBounds="True" />
                </ScrollViewer>
            </Border>
        </DockPanel>

        <GridSplitter
            Grid.Column="2"
            Width="5"
            HorizontalAlignment="Stretch" />

        <TabControl Grid.Column="3" Margin="4,0,0,0">
            <TabItem x:Name="UnitsTab" Header="인물">
                <DockPanel>
                    <TextBlock
                        Margin="0,4,0,4"
                        DockPanel.Dock="Bottom"
                        Foreground="DimGray"
                        Text="Lv·HP·TP·ATK 는 Chr 파일 값 + 장비 보너스(GameDatabase 식). 적·NPC 의 실제 레벨 = 레벨 보정 + 파티 상위 3명 평균(ba-6), 명부(0002.nch·세이브)에 있는 인물은 저장 값으로 나온다 — 여기는 반영 안 함. 편대원(For.dat)은 그리지 않는다. 깨어남: 0 처음부터 · 1 같은 편과 거리 ≤ 값 · 2 적과 거리 ≤ 값 · 3 틱 ≥ 값."
                        TextWrapping="Wrap" />
                    <DataGrid
                        x:Name="UnitGrid"
                        AutoGenerateColumns="False"
                        AutomationProperties.AutomationId="BattleUnitGrid"
                        CanUserAddRows="False"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        SelectionChanged="UnitGrid_SelectionChanged"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding No}" Header="#" />
                            <DataGridTextColumn Binding="{Binding Name}" Header="이름" />
                            <DataGridTextColumn Binding="{Binding Side}" Header="편" />
                            <DataGridTextColumn Binding="{Binding Level}" Header="Lv" />
                            <DataGridTextColumn Binding="{Binding LevelOffset}" Header="보정" />
                            <DataGridTextColumn Binding="{Binding Cell}" Header="칸" />
                            <DataGridTextColumn Binding="{Binding Facing}" Header="방향" />
                            <DataGridTextColumn Binding="{Binding Hp}" Header="HP" />
                            <DataGridTextColumn Binding="{Binding Tp}" Header="TP" />
                            <DataGridTextColumn Binding="{Binding Atk}" Header="ATK" />
                            <DataGridTextColumn Binding="{Binding Squad}" Header="편대" />
                            <DataGridTextColumn Binding="{Binding Wake}" Header="AI 깨어남" />
                            <DataGridTextColumn Binding="{Binding Chr}" Header="Chr" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="EventsTab" Header="이벤트">
                <DockPanel>
                    <TextBlock
                        x:Name="EventStatus"
                        Margin="0,4,0,4"
                        DockPanel.Dock="Top"
                        Foreground="DimGray"
                        TextWrapping="Wrap" />
                    <ListBox
                        x:Name="EventList"
                        AutomationProperties.AutomationId="BattleEventList"
                        HorizontalContentAlignment="Stretch"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        VirtualizingPanel.ScrollUnit="Pixel" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
