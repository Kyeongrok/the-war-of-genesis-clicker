<Window
    x:Class="WarOfGenesis.Editor.BattleMapWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WarOfGenesis Editor — 전투맵 보기"
    Width="1500"
    Height="1000"
    WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock
                Margin="0,0,0,4"
                DockPanel.Dock="Top"
                FontWeight="Bold"
                Text="전투(Btl) · 맵(Obt)" />
            <TextBox
                x:Name="FilterBox"
                Margin="0,0,0,4"
                AutomationProperties.AutomationId="MapFilterBox"
                DockPanel.Dock="Top"
                TextChanged="Filter_Changed" />
            <CheckBox
                x:Name="ShowBareMapsToggle"
                Margin="0,0,0,4"
                Checked="Filter_Changed"
                Content="전투에 안 쓰인 맵(Obt)도 보이기"
                DockPanel.Dock="Top"
                IsChecked="True"
                Unchecked="Filter_Changed" />
            <TextBlock
                x:Name="ListStatus"
                Margin="0,0,0,4"
                DockPanel.Dock="Top"
                Foreground="DimGray" />
            <ListBox
                x:Name="MapList"
                AutomationProperties.AutomationId="MapList"
                SelectionChanged="MapList_SelectionChanged" />
        </DockPanel>

        <DockPanel Grid.Column="1">
            <StackPanel
                Margin="0,0,0,6"
                DockPanel.Dock="Top"
                Orientation="Horizontal">
                <CheckBox
                    x:Name="GridToggle"
                    Margin="0,0,12,0"
                    Checked="View_Changed"
                    Content="격자"
                    Unchecked="View_Changed" />
                <CheckBox
                    x:Name="UnitsToggle"
                    Margin="0,0,12,0"
                    Checked="View_Changed"
                    Content="인물·배치 칸"
                    IsChecked="True"
                    Unchecked="View_Changed" />
            </StackPanel>
            <TextBlock
                x:Name="StatusText"
                MaxHeight="140"
                Margin="0,0,0,8"
                DockPanel.Dock="Top"
                TextWrapping="Wrap" />
            <Border
                Background="#FF14100C"
                BorderBrush="Gray"
                BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="Board" ClipToBounds="True" />
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Grid>
</Window>
