<Window
    x:Class="WarOfGenesis.Editor.BattleListWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="전투 목록 (챕터별)"
    Width="1600"
    Height="900"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!--  긴 칸은 너비를 묶어 두고, 잘린 글은 마우스를 얹으면 다 보이게 한다.  -->
        <Style x:Key="LongCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="8">
        <StackPanel
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="찾기(번호·이름·챕터·장소·인물·조건):" />
            <TextBox
                x:Name="FilterBox"
                Width="260"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="BattleListFilterBox"
                TextChanged="Filter_Changed" />
            <CheckBox
                x:Name="OrphanToggle"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Checked="Filter_Changed"
                Content="챕터에 못 이은 전투도 보이기"
                IsChecked="True"
                Unchecked="Filter_Changed" />
            <Button
                x:Name="OpenButton"
                Margin="12,0,0,0"
                Padding="10,2"
                AutomationProperties.AutomationId="BattleListOpenButton"
                Click="OpenButton_Click"
                Content="전투 보기 창에서 열기" />
            <TextBlock
                x:Name="StatusText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Foreground="DimGray" />
        </StackPanel>

        <TextBlock
            Margin="0,6,0,0"
            DockPanel.Dock="Bottom"
            Foreground="DimGray"
            Text="옵시디안 분석-전투목록(ba-7). 챕터 → 항성계 → 행성 → 장소 순으로 전투가 걸린다: 장소를 고르거나(Chp 장소 레코드), Chp·Fld 스크립트 행동 10, 앞 전투 이벤트 행동 10(이어서). 챕터 묶음은 이 세 간선으로 닿는 관계로 계산한다 — 여러 챕터에서 닿는 전투는 제목 txr 이 앞선 챕터에 넣고 '챕터' 칸에 다 적는다. 아군 = 부대 4(플레이어 조종) · 동맹 = 부대 3(같은 편 AI) · 적 = 부대 0·1·2. 편대(For.dat) 졸병은 안 셌다. 배치칸 = 전투 시작 때 플레이어가 부대원을 놓는 칸 수. 줄을 두 번 누르면 그 전투의 맵·배치를 전투 보기 창에서 연다."
            TextWrapping="Wrap" />

        <DataGrid
            x:Name="Grid"
            AutoGenerateColumns="False"
            AutomationProperties.AutomationId="BattleListGrid"
            CanUserAddRows="False"
            FrozenColumnCount="2"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            IsReadOnly="True"
            KeyDown="Grid_KeyDown"
            MouseDoubleClick="Grid_MouseDoubleClick"
            SelectionMode="Single"
            VerticalScrollBarVisibility="Auto">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander
                                            Margin="0,4,0,0"
                                            Background="#FFECECEC"
                                            IsExpanded="True">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        FontWeight="Bold"
                                                        Text="{Binding Name}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Margin="10,0,0,0"
                                                        Foreground="DimGray"
                                                        Text="전투" />
                                                    <TextBlock
                                                        Margin="4,0,0,0"
                                                        Foreground="DimGray"
                                                        Text="{Binding ItemCount}" />
                                                    <TextBlock Foreground="DimGray" Text="개" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsPresenter />
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id, StringFormat=D4}" Header="Btl" />
                <DataGridTextColumn
                    MaxWidth="150"
                    Binding="{Binding Name}"
                    ElementStyle="{StaticResource LongCell}"
                    Header="이름" />
                <DataGridTextColumn Binding="{Binding MapId, StringFormat=D4}" Header="맵" />
                <DataGridTextColumn Binding="{Binding Obt}" Header="Obt" />
                <DataGridTextColumn Binding="{Binding AllyCount}" Header="아군" />
                <DataGridTextColumn Binding="{Binding AlliedCount}" Header="동맹" />
                <DataGridTextColumn Binding="{Binding EnemyCount}" Header="적" />
                <DataGridTextColumn Binding="{Binding PlacementCount}" Header="배치칸" />
                <DataGridTextColumn
                    MaxWidth="180"
                    Binding="{Binding Allies}"
                    ElementStyle="{StaticResource LongCell}"
                    Header="아군·동맹 인물" />
                <DataGridTextColumn
                    MaxWidth="230"
                    Binding="{Binding Enemies}"
                    ElementStyle="{StaticResource LongCell}"
                    Header="적 구성" />
                <DataGridTextColumn
                    MaxWidth="170"
                    Binding="{Binding Win}"
                    ElementStyle="{StaticResource LongCell}"
                    Header="승리 조건" />
                <DataGridTextColumn
                    MaxWidth="170"
                    Binding="{Binding Lose}"
                    ElementStyle="{StaticResource LongCell}"
                    Header="패배 조건" />
                <DataGridTextColumn
                    MaxWidth="300"
                    Binding="{Binding Callers}"
                    ElementStyle="{StaticResource LongCell}"
                    Header="불리는 곳" />
                <DataGridTextColumn
                    MaxWidth="220"
                    Binding="{Binding Chapters}"
                    ElementStyle="{StaticResource LongCell}"
                    Header="챕터" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
