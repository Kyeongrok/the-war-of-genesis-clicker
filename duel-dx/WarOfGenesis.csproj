<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- 글자를 찍는 데만 GDI+(System.Drawing)를 쓴다 — 화면 자체는 순수 Win32 창 + DirectX 다. -->
        <UseWindowsForms>true</UseWindowsForms>
        <!-- 창·실행 파일 아이콘 — 원본 게임 아이콘(menu-5) -->
        <ApplicationIcon>..\assets\icons\game.ico</ApplicationIcon>
        <AssemblyName>WarOfGenesis</AssemblyName>
        <!-- 창 제목에 찍는 버전 — 릴리즈는 태그로 덮어쓴다(-p:Version). 손으로 빌드하면 개발판. -->
        <Version>0.0.0-dev</Version>
        <RootNamespace>DuelDx</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
        <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
        <!-- 설치판(Setup.exe)과 자동 업데이트 — CLI(vpk, release.yml)와 버전을 맞춘다. -->
        <PackageReference Include="Velopack" Version="0.0.1298" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\WarOfGenesis.Assets\WarOfGenesis.Assets.csproj" />
    </ItemGroup>

    <!-- 손으로 빌드할 때는 git 의 마지막 태그를 버전으로 싣는다(v0.10.0-2-gabc1234 → 창 제목 v0.10.0+2).
         릴리즈는 -p:Version 으로 태그를 주므로 건드리지 않는다. git 이 없으면 개발판 그대로. -->
    <Target Name="StampGitVersion" BeforeTargets="GetAssemblyAttributes" Condition="'$(Version)' == '0.0.0-dev'">
        <Exec Command="git describe --tags --long --match v*" ConsoleToMSBuild="true" StandardOutputImportance="low"
              IgnoreExitCode="true" WorkingDirectory="$(MSBuildProjectDirectory)">
            <Output TaskParameter="ConsoleOutput" PropertyName="GitDescribe" />
            <Output TaskParameter="ExitCode" PropertyName="GitDescribeExit" />
        </Exec>
        <PropertyGroup Condition="'$(GitDescribeExit)' == '0'">
            <InformationalVersion>$(GitDescribe.TrimStart('v'))</InformationalVersion>
        </PropertyGroup>
    </Target>

    <!-- 배포용 exe 에 저장소의 assets 폴더를 함께 싣는다. 단일 exe 로 publish 할 때
         IncludeAllContentForSelfExtract 로 exe 안에 묶여 실행 시 풀린다(AssetsFolder 가 찾는다). -->
    <ItemGroup>
        <!-- 원본 게임의 자료는 싣지 않는다 — 우리 것(스킬·직업·인물 목록 JSON, 꺼낼 목록, 아이콘)만 싣고
             나머지는 사용자의 원본 게임 폴더에서 읽는다(WarOfGenesis.Assets/OriginalAssets.cs · tools/make_originals_manifest.py). -->
        <Content Include="..\assets\**\*.json;..\assets\originals.txt;..\assets\patches.txt" LinkBase="assets" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\assets\icons\*" LinkBase="assets\icons" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <!-- 업데이트한 뒤 처음 켤 때 띄우는 릴리즈 노트(System/ReleaseNotesScreen.cs). -->
        <Content Include="..\릴리즈노트.md" Link="릴리즈노트.md" CopyToOutputDirectory="PreserveNewest" />
        <!-- 릴리즈 노트 창 아래 「도움을 주신 분들」 칸의 명단. -->
        <Content Include="..\contributor.md" Link="contributor.md" CopyToOutputDirectory="PreserveNewest" />
        <!-- 전투 통계를 받는 곳의 주소(System/BattleStats.cs) — 비어 있으면 안 보낸다. -->
        <Content Include="..\stats-url.txt" Link="stats-url.txt" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Ability\" />
      <Folder Include="Battle\" />
      <Folder Include="Field\" />
      <Folder Include="Moses\" />
      <Folder Include="System\" />
    </ItemGroup>

</Project>
