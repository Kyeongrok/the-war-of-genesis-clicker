<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- 글자를 찍는 데만 GDI+(System.Drawing)를 쓴다 — 화면 자체는 순수 Win32 창 + DirectX 다. -->
        <UseWindowsForms>true</UseWindowsForms>
        <!-- 창·실행 파일 아이콘 — 원본 게임 아이콘(menu-5) -->
        <ApplicationIcon>..\assets\icons\game.ico</ApplicationIcon>
        <AssemblyName>WarOfGenesis</AssemblyName>
        <!-- 창 제목에 찍는 버전 — 릴리즈는 태그로 덮어쓴다(-p:Version). 손으로 빌드하면 개발판. -->
        <Version>0.0.0-dev</Version>
        <RootNamespace>DuelDx</RootNamespace>
    </PropertyGroup>

    <Import Project="AssetPack.props" />
    <ItemGroup>
        <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
        <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
        <!-- 설치판(Setup.exe)과 자동 업데이트 — CLI(vpk, release.yml)와 버전을 맞춘다. -->
        <PackageReference Include="Velopack" Version="0.0.1298" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\WarOfGenesis.Assets\WarOfGenesis.Assets.csproj" />
    </ItemGroup>

    <!-- 손으로 빌드할 때는 git 의 마지막 태그를 버전으로 싣는다(v0.10.0-2-gabc1234 → 창 제목 v0.10.0+2).
         릴리즈는 -p:Version 으로 태그를 주므로 건드리지 않는다. git 이 없으면 개발판 그대로. -->
    <Target Name="StampGitVersion" BeforeTargets="GetAssemblyAttributes" Condition="'$(Version)' == '0.0.0-dev'">
        <Exec Command="git describe --tags --long --match v*" ConsoleToMSBuild="true" StandardOutputImportance="low"
              IgnoreExitCode="true" WorkingDirectory="$(MSBuildProjectDirectory)">
            <Output TaskParameter="ConsoleOutput" PropertyName="GitDescribe" />
            <Output TaskParameter="ExitCode" PropertyName="GitDescribeExit" />
        </Exec>
        <PropertyGroup Condition="'$(GitDescribeExit)' == '0'">
            <InformationalVersion>$(GitDescribe.TrimStart('v'))</InformationalVersion>
        </PropertyGroup>
    </Target>

    <!-- 배포용 exe 에 저장소의 assets 폴더(캐릭터·배경)를 함께 싣는다. 단일 exe 로 publish 할 때
         IncludeAllContentForSelfExtract 로 exe 안에 묶여 실행 시 풀린다(AssetsFolder 가 찾는다). -->
    <ItemGroup>
        <!-- 큰 음악과 전투 맵(AssetPack.props 의 목록)은 싣지 않는다 — 게임이 켜질 때 릴리즈 assets-pack-1 에서 받는다
             (duel-dx/AssetPack.cs · tools/make_asset_pack.py, 사용자 요청: 설치판이 651MB 였다). -->
        <Content Include="..\assets\**\*" Exclude="@(PackedAsset)" LinkBase="assets" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Ability\" />
      <Folder Include="Battle\" />
      <Folder Include="Field\" />
      <Folder Include="Moses\" />
      <Folder Include="System\" />
    </ItemGroup>

</Project>
