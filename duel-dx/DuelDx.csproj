<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- 글자를 찍는 데만 GDI+(System.Drawing)를 쓴다 — 화면 자체는 순수 Win32 창 + DirectX 다. -->
        <UseWindowsForms>true</UseWindowsForms>
        <ApplicationIcon />
        <AssemblyName>DuelDx</AssemblyName>
        <RootNamespace>DuelDx</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
        <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    </ItemGroup>

</Project>
